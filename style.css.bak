/* ============================================================
   ROOT & DESIGN TOKENS — ธีมสีส้ม + น้ำเงิน
   ============================================================ */
:root {
  /* === ORANGE (Primary Action) === */
  --orange-900: #7c2d12;
  --orange-800: #9a3412;
  --orange-700: #c2410c;
  --orange-600: #ea580c;
  --orange-500: #f97316;
  --orange-400: #fb923c;
  --orange-300: #fdba74;
  --orange-100: #ffedd5;
  --orange-50:  #fff7ed;

  /* === NAVY BLUE (Structure / Header) === */
  --navy-900:  #0a1628;
  --navy-800:  #0f2444;
  --navy-700:  #1e3a5f;
  --navy-600:  #1d4ed8;
  --navy-500:  #2563eb;
  --navy-400:  #3b82f6;
  --navy-300:  #93c5fd;
  --navy-100:  #dbeafe;
  --navy-50:   #eff6ff;

  /* === NEUTRALS === */
  --gray-900:  #111827;
  --gray-800:  #1f2937;
  --gray-700:  #374151;
  --gray-600:  #4b5563;
  --gray-500:  #6b7280;
  --gray-400:  #9ca3af;
  --gray-300:  #d1d5db;
  --gray-200:  #e5e7eb;
  --gray-100:  #f3f4f6;
  --gray-50:   #f9fafb;
  --white:     #ffffff;

  --danger:    #dc2626;
  --success:   #16a34a;
  --warning:   #d97706;

  --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
  --shadow-md: 0 4px 6px rgba(0,0,0,0.07), 0 2px 4px rgba(0,0,0,0.06);
  --shadow-lg: 0 10px 25px rgba(0,0,0,0.1), 0 4px 10px rgba(0,0,0,0.07);
  --shadow-xl: 0 20px 40px rgba(0,0,0,0.15);

  --radius-sm:   6px;
  --radius-md:   10px;
  --radius-lg:   16px;
  --radius-xl:   24px;
  --radius-full: 9999px;

  --transition:      all 0.22s cubic-bezier(0.4,0,0.2,1);
  --transition-slow: all 0.4s cubic-bezier(0.4,0,0.2,1);
  --font-body: 'Sarabun', 'Noto Sans Thai', sans-serif;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: #f1f5f9;
  color: var(--gray-800);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
a { text-decoration: none; color: inherit; }
button { cursor: pointer; font-family: var(--font-body); }
input, select, textarea { font-family: var(--font-body); }
.hidden { display: none !important; }
.mt-8 { margin-top: 8px; }

/* ============================================================
   HEADER — Navy Blue Gradient
   ============================================================ */
.site-header {
  background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 50%, var(--navy-700) 100%);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-xl);
}

.header-bg-pattern {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 15% 50%, rgba(249,115,22,0.12) 0%, transparent 50%),
    radial-gradient(circle at 85% 20%, rgba(59,130,246,0.1) 0%, transparent 40%),
    radial-gradient(circle at 55% 85%, rgba(15,36,68,0.6) 0%, transparent 50%);
  pointer-events: none;
}

.header-content {
  position: relative;
  z-index: 1;
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 28px 16px;
  display: flex;
  align-items: center;
  gap: 22px;
}

.header-logo-wrap {
  flex-shrink: 0;
  width: 92px;
  height: 92px;
  background: rgba(255,255,255,0.97);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  box-shadow: 0 0 0 3px rgba(249,115,22,0.5), var(--shadow-lg);
  transition: var(--transition);
}
.header-logo-wrap:hover {
  transform: scale(1.05);
  box-shadow: 0 0 0 5px rgba(249,115,22,0.7), var(--shadow-xl);
}
.school-logo { width: 100%; height: 100%; object-fit: contain; }

.header-text { flex: 1; }

.school-name {
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--white);
  line-height: 1.3;
  text-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

.dept-name {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--navy-300);
  margin-top: 4px;
  opacity: 0.9;
}

.system-title {
  display: inline-block;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--white);
  background: linear-gradient(135deg, var(--orange-600), var(--orange-500));
  padding: 4px 16px;
  border-radius: var(--radius-full);
  margin-top: 6px;
  box-shadow: 0 2px 10px rgba(234,88,12,0.5);
  letter-spacing: 0.03em;
}

.header-actions { flex-shrink: 0; }

.btn-admin-login {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(249,115,22,0.15);
  backdrop-filter: blur(10px);
  color: var(--white);
  border: 1.5px solid rgba(249,115,22,0.5);
  border-radius: var(--radius-full);
  padding: 9px 20px;
  font-size: 0.875rem;
  font-weight: 600;
  transition: var(--transition);
}
.btn-admin-login:hover {
  background: rgba(249,115,22,0.35);
  border-color: var(--orange-400);
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(249,115,22,0.3);
}

/* Navigation */
.main-nav {
  position: relative;
  z-index: 1;
  background: rgba(0,0,0,0.25);
  backdrop-filter: blur(4px);
  display: flex;
  gap: 2px;
  padding: 0 28px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.nav-link {
  display: block;
  padding: 12px 20px;
  font-size: 0.875rem;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
  border-bottom: 3px solid transparent;
  transition: var(--transition);
  white-space: nowrap;
}
.nav-link:hover {
  color: var(--white);
  background: rgba(249,115,22,0.1);
}
.nav-link.active {
  color: var(--white);
  border-bottom-color: var(--orange-500);
  background: rgba(249,115,22,0.12);
}

.btn-nav-refresh {
  margin-left: auto;
  align-self: center;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.28);
  color: var(--white);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  white-space: nowrap;
}
.btn-nav-refresh:hover {
  background: rgba(249,115,22,0.35);
  border-color: var(--orange-400);
  transform: translateY(-1px);
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */
.main-content {
  flex: 1;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 28px 28px;
}

.page { display: block; animation: fadeIn 0.3s ease; }
.page.hidden { display: none; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

.page-header { margin-bottom: 24px; }

.page-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--navy-800);
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}
.page-title-icon { font-size: 1.4rem; }
.page-subtitle { font-size: 0.9rem; color: var(--gray-500); }

/* ============================================================
   FORM
   ============================================================ */
.form-container {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 36px;
  border: 1px solid var(--gray-200);
  border-top: 4px solid var(--orange-500);
}

.form-row { margin-bottom: 20px; }
.form-row.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-group { display: flex; flex-direction: column; }

.form-label {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--gray-700);
  margin-bottom: 7px;
}
.form-label.required::after,
.sub-label.required::after {
  content: ' *';
  color: var(--danger);
  font-weight: 700;
}

.sub-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--gray-600);
  margin-bottom: 6px;
  display: block;
}

.form-input,
.form-select,
.form-textarea {
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-size: 0.9375rem;
  color: var(--gray-800);
  background: var(--white);
  transition: var(--transition);
  outline: none;
  width: 100%;
}
.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: var(--orange-500);
  box-shadow: 0 0 0 3px rgba(249,115,22,0.12);
}
.form-input:hover, .form-select:hover { border-color: var(--orange-400); }
.form-textarea { resize: vertical; min-height: 90px; }
.form-input.error, .form-select.error, .form-textarea.error {
  border-color: var(--danger);
  box-shadow: 0 0 0 3px rgba(220,38,38,0.1);
}
.field-error { font-size: 0.8rem; color: var(--danger); margin-top: 4px; min-height: 18px; }

.datetime-row { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 14px; }
.datetime-field { display: flex; flex-direction: column; }

/* ============================================================
   CLASSROOM MULTI-SELECT PANEL
   ============================================================ */
.classroom-selector {
  margin-top: 10px;
  background: var(--navy-50);
  border: 1.5px solid #fed7aa;
  border-radius: var(--radius-lg);
  padding: 14px 16px;
  animation: fadeIn 0.2s ease;
}

.cr-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.cr-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--navy-800);
}

.cr-icon { font-size: 1.1rem; }

.cr-quick-actions {
  display: flex;
  gap: 6px;
}

.btn-cr-action {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--gray-300);
  background: var(--white);
  color: var(--gray-700);
  transition: var(--transition);
  cursor: pointer;
}
.btn-cr-action:hover {
  background: var(--orange-50);
  border-color: var(--orange-400);
  color: var(--orange-700);
}
.btn-cr-action.clear:hover {
  background: #fee2e2;
  border-color: #f87171;
  color: var(--danger);
}

.cr-grade-tabs {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.cr-tab {
  flex: 1;
  min-width: 48px;
  padding: 6px 10px;
  background: var(--white);
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--gray-700);
  transition: var(--transition);
  text-align: center;
  cursor: pointer;
}
.cr-tab:hover {
  border-color: var(--orange-500);
  color: var(--orange-600);
  background: var(--orange-50);
}
.cr-tab.active {
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
  border-color: var(--navy-800);
  color: var(--white);
  box-shadow: 0 2px 8px rgba(15,36,68,0.25);
}

.cr-rooms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
  gap: 8px;
  margin-bottom: 12px;
}

.room-card-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 6px;
  background: var(--white);
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--gray-700);
  cursor: pointer;
  transition: var(--transition);
  user-select: none;
}
.room-card-btn:hover {
  border-color: var(--orange-400);
  background: var(--orange-50);
  transform: translateY(-1px);
}
.room-card-btn.checked {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-color: var(--orange-500);
  color: var(--orange-800);
  box-shadow: 0 2px 8px rgba(249,115,22,0.25);
}
.room-card-btn .cr-check-icon {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 1.5px solid var(--gray-400);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  line-height: 1;
  color: transparent;
  transition: var(--transition);
}
.room-card-btn.checked .cr-check-icon {
  background: var(--orange-500);
  border-color: var(--orange-500);
  color: var(--white);
}

.cr-selected-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: var(--white);
  border: 1px dashed var(--orange-300);
  border-radius: var(--radius-md);
  flex-wrap: wrap;
}

.cr-selected-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--gray-600);
  flex-shrink: 0;
}

.cr-selected-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1;
}

.cr-no-selection {
  font-size: 0.8rem;
  color: var(--gray-400);
  font-style: italic;
}

.cr-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: var(--orange-100);
  color: var(--orange-900);
  border: 1px solid var(--orange-300);
  border-radius: var(--radius-full);
  padding: 2px 8px 2px 10px;
  font-size: 0.78rem;
  font-weight: 700;
  animation: fadeIn 0.15s ease;
}

.cr-chip-remove {
  background: none;
  border: none;
  color: var(--orange-700);
  font-size: 13px;
  line-height: 1;
  font-weight: 800;
  padding: 0 2px;
  cursor: pointer;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.cr-chip-remove:hover {
  color: var(--danger);
  background: rgba(220,38,38,0.1);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid var(--gray-200);
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
  color: var(--white);
  border: none;
  border-radius: var(--radius-md);
  padding: 10px 22px;
  font-size: 0.9375rem;
  font-weight: 700;
  transition: var(--transition);
  box-shadow: 0 2px 10px rgba(234,88,12,0.35);
}
.btn-primary:hover {
  background: linear-gradient(135deg, var(--orange-600), var(--orange-700));
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(234,88,12,0.5);
}
.btn-primary:active { transform: translateY(0); }

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--white);
  color: var(--gray-700);
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  padding: 10px 22px;
  font-size: 0.9375rem;
  font-weight: 500;
  transition: var(--transition);
}
.btn-secondary:hover { background: var(--gray-50); border-color: var(--gray-400); transform: translateY(-1px); }

.btn-danger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, #dc2626, #b91c1c);
  color: var(--white);
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  transition: var(--transition);
}
.btn-danger:hover { transform: translateY(-1px); }

.btn-info {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, var(--navy-600), var(--navy-700));
  color: var(--white);
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  transition: var(--transition);
}
.btn-info:hover { transform: translateY(-1px); }

.btn-edit {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
  color: var(--white);
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  transition: var(--transition);
}
.btn-edit:hover { transform: translateY(-1px); }

/* ============================================================
   CALENDAR
   ============================================================ */
.calendar-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 16px 22px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  border-left: 4px solid var(--orange-500);
}

.calendar-nav { display: flex; align-items: center; gap: 12px; }

.btn-cal-nav {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-full);
  border: 1.5px solid var(--gray-300);
  background: var(--white);
  font-size: 1.4rem;
  color: var(--navy-700);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  line-height: 1;
}
.btn-cal-nav:hover {
  background: var(--orange-50);
  border-color: var(--orange-400);
  color: var(--orange-600);
  transform: scale(1.08);
}

.cal-month-display {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--navy-800);
  min-width: 200px;
  text-align: center;
}

.calendar-filter { display: flex; align-items: center; gap: 10px; }
.filter-label { font-size: 0.875rem; font-weight: 700; color: var(--gray-600); white-space: nowrap; }

.calendar-legend {
  display: flex;
  gap: 20px;
  margin-bottom: 14px;
  padding: 0 4px;
}
.legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--gray-600); }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; }
.legend-dot.booked    { background: var(--orange-100); border: 1.5px solid var(--orange-400); }
.legend-dot.cancelled { background: var(--gray-100); border: 1.5px solid var(--gray-400); }
.legend-dot.today     { background: var(--navy-100); border: 2.5px solid var(--navy-500); }

.calendar-grid {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--gray-200);
  overflow: hidden;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
}

.cal-weekday {
  padding: 12px 0;
  text-align: center;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: 0.05em;
}
.cal-weekday.weekend { color: var(--navy-300); }

.cal-days { display: grid; grid-template-columns: repeat(7, 1fr); }

.cal-day {
  min-height: 100px;
  padding: 8px;
  border-right: 1px solid var(--gray-100);
  border-bottom: 1px solid var(--gray-100);
  cursor: pointer;
  transition: background 0.15s;
  position: relative;
}
.cal-day:hover:not(.other-month) { background: var(--orange-50); }
.cal-day.other-month { background: var(--gray-50); opacity: 0.45; cursor: default; }

.cal-day.today { background: var(--navy-50); }
.cal-day.today .cal-day-num {
  background: var(--navy-600);
  color: var(--white);
  border-radius: var(--radius-full);
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.cal-day-num {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--gray-700);
  margin-bottom: 4px;
  display: inline-block;
  width: 26px;
  height: 26px;
  line-height: 26px;
  text-align: center;
}
.cal-day.weekend .cal-day-num { color: var(--gray-400); }

.cal-bookings { display: flex; flex-direction: column; gap: 4px; }

.cal-booking-chip {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 4px 6px;
  border-radius: 6px;
  line-height: 1.35;
  cursor: pointer;
  transition: var(--transition);
  box-shadow: 0 1px 2px rgba(0,0,0,0.04);
}
.cal-booking-chip:hover {
  opacity: 0.92;
  transform: translateY(-1px);
  box-shadow: 0 2px 5px rgba(0,0,0,0.08);
}

.cal-booking-chip .chip-room {
  font-weight: 800;
  font-size: 0.72rem;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--orange-900);
}
.cal-booking-chip .chip-meta {
  font-size: 0.64rem;
  opacity: 0.9;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cal-booking-chip.approved {
  background: #fff7ed;
  color: var(--orange-800);
  border-left: 3.5px solid var(--orange-500);
  border-top: 1px solid #fed7aa;
  border-right: 1px solid #fed7aa;
  border-bottom: 1px solid #fed7aa;
}
.cal-booking-chip.approved .chip-room {
  color: var(--orange-900);
}

.cal-booking-chip.cancelled {
  background: var(--gray-100);
  color: var(--gray-500);
  border-left: 3.5px solid var(--gray-400);
  border-top: 1px solid var(--gray-200);
  border-right: 1px solid var(--gray-200);
  border-bottom: 1px solid var(--gray-200);
  text-decoration: line-through;
}
.cal-booking-chip.cancelled .chip-room {
  color: var(--gray-600);
}
.cal-more {
  font-size: 0.68rem;
  color: var(--navy-600);
  font-weight: 700;
  padding: 1px 6px;
  cursor: pointer;
}

/* Day Detail Modal */
.day-detail-modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}
.day-detail-content {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  width: 100%;
  max-width: 580px;
  max-height: 80vh;
  overflow-y: auto;
}
.day-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid var(--gray-200);
  background: linear-gradient(135deg, var(--navy-50), var(--orange-50));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  position: sticky;
  top: 0;
}
.day-detail-header h3 { font-size: 1.05rem; font-weight: 700; color: var(--navy-800); }

/* ============================================================
   TABLE
   ============================================================ */
.history-table-wrap {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--gray-200);
  overflow: hidden;
  overflow-x: auto;
}

.history-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

.history-table thead {
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
}
.history-table th {
  padding: 13px 14px;
  text-align: left;
  font-weight: 700;
  color: var(--white);
  white-space: nowrap;
  font-size: 0.82rem;
  letter-spacing: 0.03em;
}
.history-table td {
  padding: 11px 14px;
  border-bottom: 1px solid var(--gray-100);
  color: var(--gray-700);
  vertical-align: middle;
}
.history-table tbody tr:hover { background: var(--orange-50); }
.history-table tbody tr:last-child td { border-bottom: none; }

.status-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.status-badge.approved  { background: var(--orange-100); color: var(--orange-800); }
.status-badge.cancelled { background: var(--gray-100);   color: var(--gray-600); }

.action-btns { display: flex; gap: 6px; flex-wrap: wrap; }

.empty-state { text-align: center; padding: 48px 24px; color: var(--gray-400); }
.empty-icon  { font-size: 3rem; margin-bottom: 12px; }
.empty-state p { font-size: 0.9rem; }

/* ============================================================
   ADMIN
   ============================================================ */
.admin-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 20px 24px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  border-left: 5px solid;
  transition: var(--transition);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.stat-card:nth-child(1) { border-left-color: var(--navy-600); }
.stat-card:nth-child(2) { border-left-color: var(--orange-500); }
.stat-card:nth-child(3) { border-left-color: var(--danger); }
.stat-value { font-size: 2.2rem; font-weight: 800; color: var(--navy-800); line-height: 1; }
.stat-label { font-size: 0.82rem; color: var(--gray-500); font-weight: 500; }

/* Admin Section Tabs (Manage / Report / Settings) */
.admin-section-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 20px;
  border-bottom: 2px solid var(--gray-200);
  padding-bottom: 0;
}

.section-tab {
  padding: 10px 22px;
  border: none;
  border-bottom: 3px solid transparent;
  background: transparent;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--gray-500);
  transition: var(--transition);
  margin-bottom: -2px;
}
.section-tab:hover  { color: var(--orange-600); }
.section-tab.active {
  color: var(--orange-600);
  border-bottom-color: var(--orange-500);
}

/* Admin Tabs (Approved / Cancelled) */
.admin-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 14px;
  background: var(--gray-100);
  border-radius: var(--radius-md);
  padding: 4px;
  width: fit-content;
}
.admin-tab {
  padding: 8px 20px;
  border-radius: var(--radius-sm);
  border: none;
  background: transparent;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--gray-600);
  transition: var(--transition);
  display: flex;
  align-items: center;
  gap: 6px;
}
.admin-tab.active { background: var(--white); color: var(--orange-700); box-shadow: var(--shadow-sm); }

.tab-badge {
  background: var(--orange-500);
  color: var(--white);
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  padding: 1px 7px;
  min-width: 20px;
  text-align: center;
}

/* ============================================================
   REPORT
   ============================================================ */
.report-controls {
  display: flex;
  align-items: flex-end;
  gap: 14px;
  margin-bottom: 22px;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  border-left: 4px solid var(--navy-600);
  flex-wrap: wrap;
}
.report-select-wrap { display: flex; flex-direction: column; gap: 6px; }
.report-select-wrap .form-input,
.report-select-wrap .form-select { min-width: 150px; }

.report-summary-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.report-section { margin-bottom: 24px; }
.report-section-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--navy-800);
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--orange-100);
  display: flex;
  align-items: center;
  gap: 8px;
}
.report-table-wrap {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  overflow: hidden;
  overflow-x: auto;
}

/* ============================================================
   SETTINGS (Change Password)
   ============================================================ */
.settings-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 32px;
  border: 1px solid var(--gray-200);
  border-top: 4px solid var(--navy-600);
  max-width: 500px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.settings-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy-800);
  margin-bottom: 4px;
}

/* ============================================================
   CONFLICT DETAIL
   ============================================================ */
.conflict-detail {
  background: #fef2f2;
  border: 1.5px solid #fca5a5;
  border-radius: var(--radius-md);
  padding: 16px;
  font-size: 0.9rem;
  color: var(--gray-700);
  line-height: 1.8;
}
.conflict-detail strong { color: var(--danger); }

/* ============================================================
   MODALS
   ============================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4px);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}
.modal-box {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  width: 100%;
  max-width: 440px;
  overflow: hidden;
}
.modal-box.large-modal { max-width: 660px; }

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  background: linear-gradient(135deg, var(--navy-50), var(--orange-50));
  border-bottom: 1px solid var(--gray-200);
}
.modal-header h3 { font-size: 1rem; font-weight: 700; color: var(--navy-800); }

.modal-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-height: 60vh;
  overflow-y: auto;
}
.modal-footer {
  padding: 16px 24px;
  background: var(--gray-50);
  border-top: 1px solid var(--gray-200);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}
.btn-close-modal {
  width: 30px;
  height: 30px;
  border-radius: var(--radius-full);
  border: none;
  background: var(--gray-200);
  color: var(--gray-600);
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}
.btn-close-modal:hover { background: var(--gray-300); }

/* Success Modal */
.success-modal {
  text-align: center;
  padding: 36px 24px;
  max-width: 400px;
}
.success-icon { font-size: 3.5rem; margin-bottom: 12px; }
.success-modal h3 { font-size: 1.3rem; font-weight: 700; color: var(--orange-700); margin-bottom: 8px; }
.success-modal p { font-size: 0.9rem; color: var(--gray-600); margin-bottom: 20px; line-height: 1.6; }
.success-modal .modal-footer { background: transparent; border: none; padding: 0; justify-content: center; }

/* Booking Detail Grid */
.booking-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.detail-item { display: flex; flex-direction: column; gap: 3px; }
.detail-item.full { grid-column: 1 / -1; }
.detail-label { font-size: 0.78rem; font-weight: 700; color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.06em; }
.detail-value { font-size: 0.9375rem; color: var(--gray-800); font-weight: 500; }

/* Cloud Status Tag */
.cloud-status-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-left: 10px;
  vertical-align: middle;
  transition: all 0.3s ease;
}
.cloud-status-tag.online {
  background: #dcfce7;
  color: #15803d;
  border: 1px solid #86efac;
}
.cloud-status-tag.offline {
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fca5a5;
}
.cloud-status-tag.syncing {
  background: #e0f2fe;
  color: #0369a1;
  border: 1px solid #7dd3fc;
}

/* ============================================================
   TOAST
   ============================================================ */
.toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gray-900);
  color: var(--white);
  padding: 12px 28px;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  box-shadow: var(--shadow-xl);
  z-index: 9999;
  animation: slideUp 0.3s ease;
  white-space: nowrap;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(20px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
.toast.success { background: linear-gradient(135deg, var(--orange-600), var(--orange-700)); }
.toast.error   { background: var(--danger); }
.toast.warning { background: var(--warning); }

/* Calendar view toggle & mobile enhancements */
.calendar-view-toggle {
  display: inline-flex;
  background: var(--gray-100);
  padding: 3px;
  border-radius: var(--radius-full);
  border: 1px solid var(--gray-300);
  gap: 3px;
}
.view-toggle-btn {
  border: none;
  background: transparent;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--gray-600);
  transition: var(--transition);
  cursor: pointer;
  white-space: nowrap;
}
.view-toggle-btn:hover {
  color: var(--navy-800);
}
.view-toggle-btn.active {
  background: var(--white);
  color: var(--orange-700);
  box-shadow: var(--shadow-sm);
}

.calendar-scroll-wrap {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--gray-200);
  background: var(--white);
  scrollbar-width: thin;
  scrollbar-color: var(--orange-400) #f1f5f9;
}
.calendar-scroll-wrap::-webkit-scrollbar {
  height: 7px;
}
.calendar-scroll-wrap::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 4px;
}
.calendar-scroll-wrap::-webkit-scrollbar-thumb {
  background: var(--orange-400);
  border-radius: 4px;
}
.calendar-scroll-wrap::-webkit-scrollbar-thumb:hover {
  background: var(--orange-500);
}

/* Mode: Fit to screen (Compact Month Grid) */
.calendar-scroll-wrap.cal-mode-fit {
  overflow-x: hidden;
}
.calendar-grid.cal-mode-fit {
  min-width: 0 !important;
  width: 100% !important;
}
.calendar-grid.cal-mode-fit .cal-weekdays {
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
}
.calendar-grid.cal-mode-fit .cal-weekday {
  padding: 8px 1px;
  font-size: clamp(0.68rem, 2.2vw, 0.78rem);
}
.calendar-grid.cal-mode-fit .cal-day {
  min-height: 52px;
  height: auto;
  padding: 4px 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 2px;
}
.calendar-grid.cal-mode-fit .cal-day-num {
  font-size: clamp(0.72rem, 2.3vw, 0.82rem);
  width: 22px;
  height: 22px;
  line-height: 22px;
  margin-bottom: 1px;
}
.calendar-grid.cal-mode-fit .cal-fit-badge-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 100%;
}
.cal-fit-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1px 4px;
  border-radius: var(--radius-full);
  font-size: clamp(0.58rem, 1.8vw, 0.68rem);
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  max-width: 96%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cal-fit-badge.booked {
  background: #ffedd5;
  color: var(--orange-900);
  border: 1px solid #fdba74;
}
.cal-fit-badge.cancelled {
  background: var(--gray-100);
  color: var(--gray-500);
  border: 1px solid var(--gray-300);
}

.cal-mobile-hint {
  display: none;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #fff7ed;
  border: 1px dashed var(--orange-300);
  color: var(--orange-800);
  font-size: 0.78rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  margin-bottom: 12px;
}

/* Calendar list view for mobile */
.calendar-list-view {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.cal-list-day-group {
  background: var(--white);
  border-radius: var(--radius-lg);
  border: 1px solid var(--gray-200);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.cal-list-day-header {
  background: linear-gradient(135deg, var(--navy-900), var(--navy-800));
  color: var(--white);
  padding: 10px 16px;
  font-size: 0.88rem;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cal-list-day-title {
  display: flex;
  align-items: center;
  gap: 8px;
}
.cal-list-day-count {
  background: rgba(249,115,22,0.25);
  border: 1px solid rgba(249,115,22,0.4);
  color: var(--orange-200);
  padding: 2px 10px;
  border-radius: var(--radius-full);
  font-size: 0.74rem;
  font-weight: 600;
}
.cal-list-day-items {
  display: flex;
  flex-direction: column;
}
.cal-list-card {
  padding: 12px 16px;
  border-bottom: 1px solid var(--gray-100);
  cursor: pointer;
  transition: background 0.15s;
}
.cal-list-card:last-child {
  border-bottom: none;
}
.cal-list-card:hover {
  background: var(--orange-50);
}
.cal-list-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 5px;
}
.cal-list-room {
  font-weight: 700;
  font-size: 0.92rem;
  color: var(--orange-900);
}
.cal-list-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  font-size: 0.82rem;
  color: var(--gray-600);
  margin-bottom: 4px;
}
.cal-list-purpose {
  font-size: 0.78rem;
  color: var(--gray-600);
  background: var(--gray-50);
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  display: inline-block;
  margin-top: 2px;
}
.cal-list-empty {
  text-align: center;
  padding: 40px 20px;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: 1px solid var(--gray-200);
  box-shadow: var(--shadow-sm);
}

/* Admin toolbar & Clear Data */
.admin-manage-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 14px;
}
.btn-clear-data {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fef2f2;
  border: 1.5px solid #fecaca;
  color: var(--danger);
  padding: 7px 16px;
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition);
}
.btn-clear-data:hover {
  background: #fee2e2;
  border-color: #f87171;
  color: #b91c1c;
  transform: translateY(-1px);
}
.btn-clear-data.prominent {
  background: linear-gradient(135deg, #fee2e2, #fef2f2);
  border: 1.5px solid #f87171;
  color: #b91c1c;
  padding: 8px 18px;
  font-size: 0.86rem;
  font-weight: 700;
  border-radius: var(--radius-full);
  box-shadow: 0 2px 6px rgba(220, 38, 38, 0.12);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.btn-clear-data.prominent:hover {
  background: #fecaca;
  border-color: #ef4444;
  color: #991b1b;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
}
.settings-card.danger-card {
  border-left: 4px solid var(--danger);
  background: #fffafa;
  border: 1px solid #fecaca;
}
.btn-danger-solid {
  background: var(--danger);
  color: var(--white);
  border: none;
  padding: 9px 18px;
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  transition: var(--transition);
}
.btn-danger-solid:hover {
  background: #b91c1c;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
}
.modal-header-danger {
  border-bottom: 2px solid #ef4444;
}
.modal-header-danger h3 {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #dc2626;
}
.clear-alert-banner {
  background: #fff7ed;
  border: 1px solid #fdba74;
  border-left: 4px solid var(--orange-500);
  padding: 10px 14px;
  border-radius: var(--radius-md);
  font-size: 0.82rem;
  color: var(--orange-900);
  line-height: 1.5;
}
.clear-scope-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
}
.scope-radio-label {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  background: var(--white);
  cursor: pointer;
  font-size: 0.85rem;
  transition: var(--transition);
}
.scope-radio-label:hover {
  background: var(--orange-50);
  border-color: var(--orange-300);
}
.clear-preview-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: var(--radius-md);
  padding: 12px;
  margin-top: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.preview-badge {
  background: #fee2e2;
  color: #b91c1c;
  font-weight: 700;
  font-size: 0.85rem;
  padding: 4px 12px;
  border-radius: var(--radius-full);
}
.preview-text {
  font-size: 0.82rem;
  color: var(--gray-600);
}
.btn-danger-solid {
  background: var(--danger);
  color: var(--white);
  border: none;
  padding: 9px 20px;
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  transition: var(--transition);
}
.btn-danger-solid:hover:not(:disabled) {
  background: #b91c1c;
  box-shadow: 0 4px 12px rgba(220,38,38,0.3);
}
.btn-danger-solid:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ============================================================
   FOOTER
   ============================================================ */
.site-footer {
  background: linear-gradient(180deg, var(--navy-900) 0%, #060e1a 100%);
  color: rgba(255, 255, 255, 0.9);
  padding: 24px 16px 28px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: auto;
  text-align: center;
}
.footer-container {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 0 6px;
}
.footer-dept-name {
  font-size: clamp(0.9rem, 2.8vw, 1.05rem);
  font-weight: 700;
  color: var(--orange-400);
  letter-spacing: 0.02em;
  line-height: 1.35;
}
.footer-school-name {
  font-size: clamp(0.78rem, 3.2vw, 0.98rem);
  font-weight: 600;
  color: #f1f5f9;
  line-height: 1.4;
  letter-spacing: 0.01em;
  white-space: normal;
  word-break: keep-all;
  max-width: 100%;
}
.footer-dev-credit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 6px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(251, 146, 60, 0.3);
  padding: 6px 18px;
  border-radius: var(--radius-full);
  font-size: clamp(0.74rem, 2.5vw, 0.84rem);
  color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  white-space: nowrap;
}
.footer-dev-icon {
  font-size: 0.95rem;
}
.footer-dev-text {
  font-weight: 500;
  color: #fed7aa;
}

/* ============================================================
   RESPONSIVE — iPad, Tablets & Mobile Devices
   ============================================================ */
@media (max-width: 1024px) {
  .header-content {
    padding: 16px 20px 14px;
    gap: 16px;
  }
  .header-logo-wrap {
    width: 70px;
    height: 70px;
  }
  .school-name {
    font-size: 1.22rem;
  }
  .dept-name {
    font-size: 0.9rem;
  }
  .system-title {
    font-size: 0.85rem;
  }
  .main-nav {
    padding: 0 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .main-nav::-webkit-scrollbar {
    display: none;
  }
  .admin-stats {
    grid-template-columns: repeat(3, 1fr);
  }
  .report-summary-cards {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .site-header {
    overflow: visible;
  }
  .header-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 14px 10px;
  }
  .header-logo-wrap {
    width: 52px;
    height: 52px;
    padding: 3px;
    flex-shrink: 0;
  }
  .header-text {
    flex: 1 1 calc(100% - 66px);
    min-width: 0;
  }
  .school-name {
    font-size: 0.98rem;
    line-height: 1.3;
    word-break: keep-all;
  }
  .dept-name {
    font-size: 0.82rem;
    margin-top: 1px;
  }
  .system-title {
    font-size: 0.74rem;
    padding: 2px 10px;
    margin-top: 3px;
  }
  .header-actions {
    flex: 1 1 100%;
    display: flex;
    justify-content: stretch;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .btn-admin-login {
    width: 100%;
    justify-content: center;
    padding: 8px 14px;
    font-size: 0.82rem;
    border-radius: var(--radius-md);
  }
  .main-nav {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 0 8px;
    gap: 4px;
    background: rgba(0, 0, 0, 0.35);
  }
  .main-nav::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    flex-shrink: 0;
    padding: 9px 12px;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .nav-link.admin-only {
    color: #fed7aa;
    font-weight: 700;
    background: rgba(249, 115, 22, 0.18);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .nav-link.admin-only.active {
    background: rgba(249, 115, 22, 0.32);
    color: var(--white);
    border-bottom-color: var(--orange-400);
  }
  .btn-nav-refresh {
    flex-shrink: 0;
    margin-left: auto;
    padding: 5px 10px;
    font-size: 0.74rem;
  }
  .main-content {
    padding: 14px 10px;
  }
  .form-container {
    padding: 18px 14px;
  }
  .form-row.two-col {
    grid-template-columns: 1fr;
  }
  .datetime-row {
    grid-template-columns: 1fr;
  }
  .calendar-controls {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding: 12px;
  }
  .calendar-nav {
    justify-content: space-between;
    width: 100%;
  }
  .calendar-view-toggle {
    width: 100%;
    display: flex;
    gap: 4px;
  }
  .view-toggle-btn {
    flex: 1;
    text-align: center;
    padding: 7px 6px;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .calendar-filter {
    width: 100%;
    flex-wrap: wrap;
  }
  .calendar-filter .form-select {
    flex: 1;
    min-width: 160px;
  }
  .cal-mobile-hint {
    display: flex;
  }
  .calendar-grid {
    min-width: 660px;
  }
  .calendar-grid.cal-mode-fit {
    min-width: 0 !important;
  }
  .admin-manage-toolbar {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .admin-tabs {
    width: 100%;
    display: flex;
  }
  .admin-tab {
    flex: 1;
    text-align: center;
  }
  .btn-clear-data.prominent {
    width: 100%;
    justify-content: center;
    padding: 9px 14px;
  }
  .admin-stats {
    grid-template-columns: 1fr 1fr;
  }
  .report-summary-cards {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 480px) {
  .admin-stats {
    grid-template-columns: 1fr;
  }
  .report-summary-cards {
    grid-template-columns: 1fr;
  }
  .view-toggle-btn {
    font-size: 0.72rem;
    padding: 6px 4px;
  }
}

@media (max-height: 520px) and (orientation: landscape) {
  .header-content {
    padding: 6px 12px 5px;
    gap: 8px;
  }
  .header-logo-wrap {
    width: 40px;
    height: 40px;
  }
  .school-name {
    font-size: 0.88rem;
  }
  .dept-name, .system-title {
    display: inline-block;
    margin: 0 4px 0 0;
    font-size: 0.7rem;
    padding: 1px 6px;
  }
  .calendar-controls {
    padding: 8px 10px;
    gap: 6px;
    margin-bottom: 8px;
  }
  .cal-day {
    min-height: 44px;
    padding: 2px 2px;
  }
}