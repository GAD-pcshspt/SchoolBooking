<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ระบบจองใช้สถานที่ - โรงเรียนวิทยาศาสตร์จุฬาภรณราชวิทยาลัย ปทุมธานี</title>
  <meta name="description" content="ระบบจองใช้สถานที่ ฝ่ายบริหารงานทั่วไป โรงเรียนวิทยาศาสตร์จุฬาภรณราชวิทยาลัย ปทุมธานี" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
/* ============================================================
   ROOT & DESIGN TOKENS — ธีมสีส้ม + น้ำเงิน
   ============================================================ */
:root {
  /* === ORANGE (Primary Action) === */
  --orange-900: #7c2d12;
  --orange-800: #9a3412;
  --orange-700: #c2410c;
  --orange-600: #ea580c;
  --orange-500: #f97316;
  --orange-400: #fb923c;
  --orange-300: #fdba74;
  --orange-100: #ffedd5;
  --orange-50:  #fff7ed;

  /* === NAVY BLUE (Structure / Header) === */
  --navy-900:  #0a1628;
  --navy-800:  #0f2444;
  --navy-700:  #1e3a5f;
  --navy-600:  #1d4ed8;
  --navy-500:  #2563eb;
  --navy-400:  #3b82f6;
  --navy-300:  #93c5fd;
  --navy-100:  #dbeafe;
  --navy-50:   #eff6ff;

  /* === NEUTRALS === */
  --gray-900:  #111827;
  --gray-800:  #1f2937;
  --gray-700:  #374151;
  --gray-600:  #4b5563;
  --gray-500:  #6b7280;
  --gray-400:  #9ca3af;
  --gray-300:  #d1d5db;
  --gray-200:  #e5e7eb;
  --gray-100:  #f3f4f6;
  --gray-50:   #f9fafb;
  --white:     #ffffff;

  --danger:    #dc2626;
  --success:   #16a34a;
  --warning:   #d97706;

  --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
  --shadow-md: 0 4px 6px rgba(0,0,0,0.07), 0 2px 4px rgba(0,0,0,0.06);
  --shadow-lg: 0 10px 25px rgba(0,0,0,0.1), 0 4px 10px rgba(0,0,0,0.07);
  --shadow-xl: 0 20px 40px rgba(0,0,0,0.15);

  --radius-sm:   6px;
  --radius-md:   10px;
  --radius-lg:   16px;
  --radius-xl:   24px;
  --radius-full: 9999px;

  --transition:      all 0.22s cubic-bezier(0.4,0,0.2,1);
  --transition-slow: all 0.4s cubic-bezier(0.4,0,0.2,1);
  --font-body: 'Sarabun', 'Noto Sans Thai', sans-serif;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: #f1f5f9;
  color: var(--gray-800);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
a { text-decoration: none; color: inherit; }
button { cursor: pointer; font-family: var(--font-body); }
input, select, textarea { font-family: var(--font-body); }
.hidden { display: none !important; }
.mt-8 { margin-top: 8px; }

/* ============================================================
   HEADER — Navy Blue Gradient
   ============================================================ */
.site-header {
  background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 50%, var(--navy-700) 100%);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-xl);
}

.header-bg-pattern {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 15% 50%, rgba(249,115,22,0.12) 0%, transparent 50%),
    radial-gradient(circle at 85% 20%, rgba(59,130,246,0.1) 0%, transparent 40%),
    radial-gradient(circle at 55% 85%, rgba(15,36,68,0.6) 0%, transparent 50%);
  pointer-events: none;
}

.header-content {
  position: relative;
  z-index: 1;
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 28px 16px;
  display: flex;
  align-items: center;
  gap: 22px;
}

.header-logo-wrap {
  flex-shrink: 0;
  width: 92px;
  height: 92px;
  background: rgba(255,255,255,0.97);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  box-shadow: 0 0 0 3px rgba(249,115,22,0.5), var(--shadow-lg);
  transition: var(--transition);
}
.header-logo-wrap:hover {
  transform: scale(1.05);
  box-shadow: 0 0 0 5px rgba(249,115,22,0.7), var(--shadow-xl);
}
.school-logo { width: 100%; height: 100%; object-fit: contain; }

.header-text { flex: 1; }

.school-name {
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--white);
  line-height: 1.3;
  text-shadow: 0 2px 8px rgba(0,0,0,0.3);
}

.dept-name {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--navy-300);
  margin-top: 4px;
  opacity: 0.9;
}

.system-title {
  display: inline-block;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--white);
  background: linear-gradient(135deg, var(--orange-600), var(--orange-500));
  padding: 4px 16px;
  border-radius: var(--radius-full);
  margin-top: 6px;
  box-shadow: 0 2px 10px rgba(234,88,12,0.5);
  letter-spacing: 0.03em;
}

.header-actions { flex-shrink: 0; }

.btn-admin-login {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(249,115,22,0.15);
  backdrop-filter: blur(10px);
  color: var(--white);
  border: 1.5px solid rgba(249,115,22,0.5);
  border-radius: var(--radius-full);
  padding: 9px 20px;
  font-size: 0.875rem;
  font-weight: 600;
  transition: var(--transition);
}
.btn-admin-login:hover {
  background: rgba(249,115,22,0.35);
  border-color: var(--orange-400);
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(249,115,22,0.3);
}

/* Navigation */
.main-nav {
  position: relative;
  z-index: 1;
  background: rgba(0,0,0,0.25);
  backdrop-filter: blur(4px);
  display: flex;
  gap: 2px;
  padding: 0 28px;
  border-top: 1px solid rgba(255,255,255,0.08);
}

.nav-link {
  display: block;
  padding: 12px 20px;
  font-size: 0.875rem;
  font-weight: 600;
  color: rgba(255,255,255,0.7);
  border-bottom: 3px solid transparent;
  transition: var(--transition);
  white-space: nowrap;
}
.nav-link:hover {
  color: var(--white);
  background: rgba(249,115,22,0.1);
}
.nav-link.active {
  color: var(--white);
  border-bottom-color: var(--orange-500);
  background: rgba(249,115,22,0.12);
}

.btn-nav-refresh {
  margin-left: auto;
  align-self: center;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.28);
  color: var(--white);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  white-space: nowrap;
}
.btn-nav-refresh:hover {
  background: rgba(249,115,22,0.35);
  border-color: var(--orange-400);
  transform: translateY(-1px);
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */
.main-content {
  flex: 1;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 28px 28px;
}

.page { display: block; animation: fadeIn 0.3s ease; }
.page.hidden { display: none; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

.page-header { margin-bottom: 24px; }

.page-title {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--navy-800);
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}
.page-title-icon { font-size: 1.4rem; }
.page-subtitle { font-size: 0.9rem; color: var(--gray-500); }

/* ============================================================
   FORM
   ============================================================ */
.form-container {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 36px;
  border: 1px solid var(--gray-200);
  border-top: 4px solid var(--orange-500);
}

.form-row { margin-bottom: 20px; }
.form-row.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.form-group { display: flex; flex-direction: column; }

.form-label {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--gray-700);
  margin-bottom: 7px;
}
.form-label.required::after,
.sub-label.required::after {
  content: ' *';
  color: var(--danger);
  font-weight: 700;
}

.sub-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--gray-600);
  margin-bottom: 6px;
  display: block;
}

.form-input,
.form-select,
.form-textarea {
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-size: 0.9375rem;
  color: var(--gray-800);
  background: var(--white);
  transition: var(--transition);
  outline: none;
  width: 100%;
}
.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: var(--orange-500);
  box-shadow: 0 0 0 3px rgba(249,115,22,0.12);
}
.form-input:hover, .form-select:hover { border-color: var(--orange-400); }
.form-textarea { resize: vertical; min-height: 90px; }
.form-input.error, .form-select.error, .form-textarea.error {
  border-color: var(--danger);
  box-shadow: 0 0 0 3px rgba(220,38,38,0.1);
}
.field-error { font-size: 0.8rem; color: var(--danger); margin-top: 4px; min-height: 18px; }

.datetime-row { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 14px; }
.datetime-field { display: flex; flex-direction: column; }

/* ============================================================
   CLASSROOM MULTI-SELECT PANEL
   ============================================================ */
.classroom-selector {
  margin-top: 10px;
  background: var(--navy-50);
  border: 1.5px solid #fed7aa;
  border-radius: var(--radius-lg);
  padding: 14px 16px;
  animation: fadeIn 0.2s ease;
}

.cr-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.cr-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--navy-800);
}

.cr-icon { font-size: 1.1rem; }

.cr-quick-actions {
  display: flex;
  gap: 6px;
}

.btn-cr-action {
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--gray-300);
  background: var(--white);
  color: var(--gray-700);
  transition: var(--transition);
  cursor: pointer;
}
.btn-cr-action:hover {
  background: var(--orange-50);
  border-color: var(--orange-400);
  color: var(--orange-700);
}
.btn-cr-action.clear:hover {
  background: #fee2e2;
  border-color: #f87171;
  color: var(--danger);
}

.cr-grade-tabs {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.cr-tab {
  flex: 1;
  min-width: 48px;
  padding: 6px 10px;
  background: var(--white);
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--gray-700);
  transition: var(--transition);
  text-align: center;
  cursor: pointer;
}
.cr-tab:hover {
  border-color: var(--orange-500);
  color: var(--orange-600);
  background: var(--orange-50);
}
.cr-tab.active {
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
  border-color: var(--navy-800);
  color: var(--white);
  box-shadow: 0 2px 8px rgba(15,36,68,0.25);
}

.cr-rooms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
  gap: 8px;
  margin-bottom: 12px;
}

.room-card-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 6px;
  background: var(--white);
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-md);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--gray-700);
  cursor: pointer;
  transition: var(--transition);
  user-select: none;
}
.room-card-btn:hover {
  border-color: var(--orange-400);
  background: var(--orange-50);
  transform: translateY(-1px);
}
.room-card-btn.checked {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border-color: var(--orange-500);
  color: var(--orange-800);
  box-shadow: 0 2px 8px rgba(249,115,22,0.25);
}
.room-card-btn .cr-check-icon {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 1.5px solid var(--gray-400);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  line-height: 1;
  color: transparent;
  transition: var(--transition);
}
.room-card-btn.checked .cr-check-icon {
  background: var(--orange-500);
  border-color: var(--orange-500);
  color: var(--white);
}

.cr-selected-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: var(--white);
  border: 1px dashed var(--orange-300);
  border-radius: var(--radius-md);
  flex-wrap: wrap;
}

.cr-selected-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--gray-600);
  flex-shrink: 0;
}

.cr-selected-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1;
}

.cr-no-selection {
  font-size: 0.8rem;
  color: var(--gray-400);
  font-style: italic;
}

.cr-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: var(--orange-100);
  color: var(--orange-900);
  border: 1px solid var(--orange-300);
  border-radius: var(--radius-full);
  padding: 2px 8px 2px 10px;
  font-size: 0.78rem;
  font-weight: 700;
  animation: fadeIn 0.15s ease;
}

.cr-chip-remove {
  background: none;
  border: none;
  color: var(--orange-700);
  font-size: 13px;
  line-height: 1;
  font-weight: 800;
  padding: 0 2px;
  cursor: pointer;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.cr-chip-remove:hover {
  color: var(--danger);
  background: rgba(220,38,38,0.1);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid var(--gray-200);
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
  color: var(--white);
  border: none;
  border-radius: var(--radius-md);
  padding: 10px 22px;
  font-size: 0.9375rem;
  font-weight: 700;
  transition: var(--transition);
  box-shadow: 0 2px 10px rgba(234,88,12,0.35);
}
.btn-primary:hover {
  background: linear-gradient(135deg, var(--orange-600), var(--orange-700));
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(234,88,12,0.5);
}
.btn-primary:active { transform: translateY(0); }

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--white);
  color: var(--gray-700);
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  padding: 10px 22px;
  font-size: 0.9375rem;
  font-weight: 500;
  transition: var(--transition);
}
.btn-secondary:hover { background: var(--gray-50); border-color: var(--gray-400); transform: translateY(-1px); }

.btn-danger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, #dc2626, #b91c1c);
  color: var(--white);
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  transition: var(--transition);
}
.btn-danger:hover { transform: translateY(-1px); }

.btn-info {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, var(--navy-600), var(--navy-700));
  color: var(--white);
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  transition: var(--transition);
}
.btn-info:hover { transform: translateY(-1px); }

.btn-edit {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
  color: var(--white);
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  transition: var(--transition);
}
.btn-edit:hover { transform: translateY(-1px); }

/* ============================================================
   CALENDAR
   ============================================================ */
.calendar-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 16px 22px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  border-left: 4px solid var(--orange-500);
}

.calendar-nav { display: flex; align-items: center; gap: 12px; }

.btn-cal-nav {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-full);
  border: 1.5px solid var(--gray-300);
  background: var(--white);
  font-size: 1.4rem;
  color: var(--navy-700);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  line-height: 1;
}
.btn-cal-nav:hover {
  background: var(--orange-50);
  border-color: var(--orange-400);
  color: var(--orange-600);
  transform: scale(1.08);
}

.cal-month-display {
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--navy-800);
  min-width: 200px;
  text-align: center;
}

.calendar-filter { display: flex; align-items: center; gap: 10px; }
.filter-label { font-size: 0.875rem; font-weight: 700; color: var(--gray-600); white-space: nowrap; }

.calendar-legend {
  display: flex;
  gap: 20px;
  margin-bottom: 14px;
  padding: 0 4px;
}
.legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--gray-600); }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; }
.legend-dot.booked    { background: var(--orange-100); border: 1.5px solid var(--orange-400); }
.legend-dot.cancelled { background: var(--gray-100); border: 1.5px solid var(--gray-400); }
.legend-dot.today     { background: var(--navy-100); border: 2.5px solid var(--navy-500); }

.calendar-grid {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--gray-200);
  overflow: hidden;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
}

.cal-weekday {
  padding: 12px 0;
  text-align: center;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: 0.05em;
}
.cal-weekday.weekend { color: var(--navy-300); }

.cal-days { display: grid; grid-template-columns: repeat(7, 1fr); }

.cal-day {
  min-height: 100px;
  padding: 8px;
  border-right: 1px solid var(--gray-100);
  border-bottom: 1px solid var(--gray-100);
  cursor: pointer;
  transition: background 0.15s;
  position: relative;
}
.cal-day:hover:not(.other-month) { background: var(--orange-50); }
.cal-day.other-month { background: var(--gray-50); opacity: 0.45; cursor: default; }

.cal-day.today { background: var(--navy-50); }
.cal-day.today .cal-day-num {
  background: var(--navy-600);
  color: var(--white);
  border-radius: var(--radius-full);
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.cal-day-num {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--gray-700);
  margin-bottom: 4px;
  display: inline-block;
  width: 26px;
  height: 26px;
  line-height: 26px;
  text-align: center;
}
.cal-day.weekend .cal-day-num { color: var(--gray-400); }

.cal-bookings { display: flex; flex-direction: column; gap: 4px; }

.cal-booking-chip {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 4px 6px;
  border-radius: 6px;
  line-height: 1.35;
  cursor: pointer;
  transition: var(--transition);
  box-shadow: 0 1px 2px rgba(0,0,0,0.04);
}
.cal-booking-chip:hover {
  opacity: 0.92;
  transform: translateY(-1px);
  box-shadow: 0 2px 5px rgba(0,0,0,0.08);
}

.cal-booking-chip .chip-room {
  font-weight: 800;
  font-size: 0.72rem;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--orange-900);
}
.cal-booking-chip .chip-meta {
  font-size: 0.64rem;
  opacity: 0.9;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cal-booking-chip.approved {
  background: #fff7ed;
  color: var(--orange-800);
  border-left: 3.5px solid var(--orange-500);
  border-top: 1px solid #fed7aa;
  border-right: 1px solid #fed7aa;
  border-bottom: 1px solid #fed7aa;
}
.cal-booking-chip.approved .chip-room {
  color: var(--orange-900);
}

.cal-booking-chip.cancelled {
  background: var(--gray-100);
  color: var(--gray-500);
  border-left: 3.5px solid var(--gray-400);
  border-top: 1px solid var(--gray-200);
  border-right: 1px solid var(--gray-200);
  border-bottom: 1px solid var(--gray-200);
  text-decoration: line-through;
}
.cal-booking-chip.cancelled .chip-room {
  color: var(--gray-600);
}
.cal-more {
  font-size: 0.68rem;
  color: var(--navy-600);
  font-weight: 700;
  padding: 1px 6px;
  cursor: pointer;
}

/* Day Detail Modal */
.day-detail-modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}
.day-detail-content {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  width: 100%;
  max-width: 580px;
  max-height: 80vh;
  overflow-y: auto;
}
.day-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid var(--gray-200);
  background: linear-gradient(135deg, var(--navy-50), var(--orange-50));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  position: sticky;
  top: 0;
}
.day-detail-header h3 { font-size: 1.05rem; font-weight: 700; color: var(--navy-800); }

/* ============================================================
   TABLE
   ============================================================ */
.history-table-wrap {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--gray-200);
  overflow: hidden;
  overflow-x: auto;
}

.history-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

.history-table thead {
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
}
.history-table th {
  padding: 13px 14px;
  text-align: left;
  font-weight: 700;
  color: var(--white);
  white-space: nowrap;
  font-size: 0.82rem;
  letter-spacing: 0.03em;
}
.history-table td {
  padding: 11px 14px;
  border-bottom: 1px solid var(--gray-100);
  color: var(--gray-700);
  vertical-align: middle;
}
.history-table tbody tr:hover { background: var(--orange-50); }
.history-table tbody tr:last-child td { border-bottom: none; }

.status-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.status-badge.approved  { background: var(--orange-100); color: var(--orange-800); }
.status-badge.cancelled { background: var(--gray-100);   color: var(--gray-600); }

.action-btns { display: flex; gap: 6px; flex-wrap: wrap; }

.empty-state { text-align: center; padding: 48px 24px; color: var(--gray-400); }
.empty-icon  { font-size: 3rem; margin-bottom: 12px; }
.empty-state p { font-size: 0.9rem; }

/* ============================================================
   ADMIN
   ============================================================ */
.admin-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 20px 24px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  border-left: 5px solid;
  transition: var(--transition);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.stat-card:nth-child(1) { border-left-color: var(--navy-600); }
.stat-card:nth-child(2) { border-left-color: var(--orange-500); }
.stat-card:nth-child(3) { border-left-color: var(--danger); }
.stat-value { font-size: 2.2rem; font-weight: 800; color: var(--navy-800); line-height: 1; }
.stat-label { font-size: 0.82rem; color: var(--gray-500); font-weight: 500; }

/* Admin Section Tabs (Manage / Report / Settings) */
.admin-section-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 20px;
  border-bottom: 2px solid var(--gray-200);
  padding-bottom: 0;
}

.section-tab {
  padding: 10px 22px;
  border: none;
  border-bottom: 3px solid transparent;
  background: transparent;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--gray-500);
  transition: var(--transition);
  margin-bottom: -2px;
}
.section-tab:hover  { color: var(--orange-600); }
.section-tab.active {
  color: var(--orange-600);
  border-bottom-color: var(--orange-500);
}

/* Admin Tabs (Approved / Cancelled) */
.admin-tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 14px;
  background: var(--gray-100);
  border-radius: var(--radius-md);
  padding: 4px;
  width: fit-content;
}
.admin-tab {
  padding: 8px 20px;
  border-radius: var(--radius-sm);
  border: none;
  background: transparent;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--gray-600);
  transition: var(--transition);
  display: flex;
  align-items: center;
  gap: 6px;
}
.admin-tab.active { background: var(--white); color: var(--orange-700); box-shadow: var(--shadow-sm); }

.tab-badge {
  background: var(--orange-500);
  color: var(--white);
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  padding: 1px 7px;
  min-width: 20px;
  text-align: center;
}

/* ============================================================
   REPORT
   ============================================================ */
.report-controls {
  display: flex;
  align-items: flex-end;
  gap: 14px;
  margin-bottom: 22px;
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  border-left: 4px solid var(--navy-600);
  flex-wrap: wrap;
}
.report-select-wrap { display: flex; flex-direction: column; gap: 6px; }
.report-select-wrap .form-input,
.report-select-wrap .form-select { min-width: 150px; }

.report-summary-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.report-section { margin-bottom: 24px; }
.report-section-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--navy-800);
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--orange-100);
  display: flex;
  align-items: center;
  gap: 8px;
}
.report-table-wrap {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-200);
  overflow: hidden;
  overflow-x: auto;
}

/* ============================================================
   SETTINGS (Change Password)
   ============================================================ */
.settings-card {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 32px;
  border: 1px solid var(--gray-200);
  border-top: 4px solid var(--navy-600);
  max-width: 500px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.settings-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy-800);
  margin-bottom: 4px;
}

/* ============================================================
   CONFLICT DETAIL
   ============================================================ */
.conflict-detail {
  background: #fef2f2;
  border: 1.5px solid #fca5a5;
  border-radius: var(--radius-md);
  padding: 16px;
  font-size: 0.9rem;
  color: var(--gray-700);
  line-height: 1.8;
}
.conflict-detail strong { color: var(--danger); }

/* ============================================================
   MODALS
   ============================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4px);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}
.modal-box {
  background: var(--white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  width: 100%;
  max-width: 440px;
  overflow: hidden;
}
.modal-box.large-modal { max-width: 660px; }

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  background: linear-gradient(135deg, var(--navy-50), var(--orange-50));
  border-bottom: 1px solid var(--gray-200);
}
.modal-header h3 { font-size: 1rem; font-weight: 700; color: var(--navy-800); }

.modal-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-height: 60vh;
  overflow-y: auto;
}
.modal-footer {
  padding: 16px 24px;
  background: var(--gray-50);
  border-top: 1px solid var(--gray-200);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}
.btn-close-modal {
  width: 30px;
  height: 30px;
  border-radius: var(--radius-full);
  border: none;
  background: var(--gray-200);
  color: var(--gray-600);
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
}
.btn-close-modal:hover { background: var(--gray-300); }

/* Success Modal */
.success-modal {
  text-align: center;
  padding: 36px 24px;
  max-width: 400px;
}
.success-icon { font-size: 3.5rem; margin-bottom: 12px; }
.success-modal h3 { font-size: 1.3rem; font-weight: 700; color: var(--orange-700); margin-bottom: 8px; }
.success-modal p { font-size: 0.9rem; color: var(--gray-600); margin-bottom: 20px; line-height: 1.6; }
.success-modal .modal-footer { background: transparent; border: none; padding: 0; justify-content: center; }

/* Booking Detail Grid */
.booking-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.detail-item { display: flex; flex-direction: column; gap: 3px; }
.detail-item.full { grid-column: 1 / -1; }
.detail-label { font-size: 0.78rem; font-weight: 700; color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.06em; }
.detail-value { font-size: 0.9375rem; color: var(--gray-800); font-weight: 500; }

/* Cloud Status Tag */
.cloud-status-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-left: 10px;
  vertical-align: middle;
  transition: all 0.3s ease;
}
.cloud-status-tag.online {
  background: #dcfce7;
  color: #15803d;
  border: 1px solid #86efac;
}
.cloud-status-tag.offline {
  background: #fee2e2;
  color: #b91c1c;
  border: 1px solid #fca5a5;
}
.cloud-status-tag.syncing {
  background: #e0f2fe;
  color: #0369a1;
  border: 1px solid #7dd3fc;
}

/* ============================================================
   TOAST
   ============================================================ */
.toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gray-900);
  color: var(--white);
  padding: 12px 28px;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
  box-shadow: var(--shadow-xl);
  z-index: 9999;
  animation: slideUp 0.3s ease;
  white-space: nowrap;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(20px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
.toast.success { background: linear-gradient(135deg, var(--orange-600), var(--orange-700)); }
.toast.error   { background: var(--danger); }
.toast.warning { background: var(--warning); }

/* Calendar view toggle & mobile enhancements */
.calendar-view-toggle {
  display: inline-flex;
  background: var(--gray-100);
  padding: 3px;
  border-radius: var(--radius-full);
  border: 1px solid var(--gray-300);
  gap: 3px;
}
.view-toggle-btn {
  border: none;
  background: transparent;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--gray-600);
  transition: var(--transition);
  cursor: pointer;
  white-space: nowrap;
}
.view-toggle-btn:hover {
  color: var(--navy-800);
}
.view-toggle-btn.active {
  background: var(--white);
  color: var(--orange-700);
  box-shadow: var(--shadow-sm);
}

.calendar-scroll-wrap {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--gray-200);
  background: var(--white);
  scrollbar-width: thin;
  scrollbar-color: var(--orange-400) #f1f5f9;
}
.calendar-scroll-wrap::-webkit-scrollbar {
  height: 7px;
}
.calendar-scroll-wrap::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 4px;
}
.calendar-scroll-wrap::-webkit-scrollbar-thumb {
  background: var(--orange-400);
  border-radius: 4px;
}
.calendar-scroll-wrap::-webkit-scrollbar-thumb:hover {
  background: var(--orange-500);
}

/* Mode: Fit to screen (Compact Month Grid) */
.calendar-scroll-wrap.cal-mode-fit {
  overflow-x: hidden;
}
.calendar-grid.cal-mode-fit {
  min-width: 0 !important;
  width: 100% !important;
}
.calendar-grid.cal-mode-fit .cal-weekdays {
  background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
}
.calendar-grid.cal-mode-fit .cal-weekday {
  padding: 8px 1px;
  font-size: clamp(0.68rem, 2.2vw, 0.78rem);
}
.calendar-grid.cal-mode-fit .cal-day {
  min-height: 52px;
  height: auto;
  padding: 4px 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 2px;
}
.calendar-grid.cal-mode-fit .cal-day-num {
  font-size: clamp(0.72rem, 2.3vw, 0.82rem);
  width: 22px;
  height: 22px;
  line-height: 22px;
  margin-bottom: 1px;
}
.calendar-grid.cal-mode-fit .cal-fit-badge-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 100%;
}
.cal-fit-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1px 4px;
  border-radius: var(--radius-full);
  font-size: clamp(0.58rem, 1.8vw, 0.68rem);
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  max-width: 96%;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cal-fit-badge.booked {
  background: #ffedd5;
  color: var(--orange-900);
  border: 1px solid #fdba74;
}
.cal-fit-badge.cancelled {
  background: var(--gray-100);
  color: var(--gray-500);
  border: 1px solid var(--gray-300);
}

.cal-mobile-hint {
  display: none;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #fff7ed;
  border: 1px dashed var(--orange-300);
  color: var(--orange-800);
  font-size: 0.78rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  margin-bottom: 12px;
}

/* Calendar list view for mobile */
.calendar-list-view {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.cal-list-day-group {
  background: var(--white);
  border-radius: var(--radius-lg);
  border: 1px solid var(--gray-200);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.cal-list-day-header {
  background: linear-gradient(135deg, var(--navy-900), var(--navy-800));
  color: var(--white);
  padding: 10px 16px;
  font-size: 0.88rem;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cal-list-day-title {
  display: flex;
  align-items: center;
  gap: 8px;
}
.cal-list-day-count {
  background: rgba(249,115,22,0.25);
  border: 1px solid rgba(249,115,22,0.4);
  color: var(--orange-200);
  padding: 2px 10px;
  border-radius: var(--radius-full);
  font-size: 0.74rem;
  font-weight: 600;
}
.cal-list-day-items {
  display: flex;
  flex-direction: column;
}
.cal-list-card {
  padding: 12px 16px;
  border-bottom: 1px solid var(--gray-100);
  cursor: pointer;
  transition: background 0.15s;
}
.cal-list-card:last-child {
  border-bottom: none;
}
.cal-list-card:hover {
  background: var(--orange-50);
}
.cal-list-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 5px;
}
.cal-list-room {
  font-weight: 700;
  font-size: 0.92rem;
  color: var(--orange-900);
}
.cal-list-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  font-size: 0.82rem;
  color: var(--gray-600);
  margin-bottom: 4px;
}
.cal-list-purpose {
  font-size: 0.78rem;
  color: var(--gray-600);
  background: var(--gray-50);
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  display: inline-block;
  margin-top: 2px;
}
.cal-list-empty {
  text-align: center;
  padding: 40px 20px;
  background: var(--white);
  border-radius: var(--radius-xl);
  border: 1px solid var(--gray-200);
  box-shadow: var(--shadow-sm);
}

/* Admin toolbar & Clear Data */
.admin-manage-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 14px;
}
.btn-clear-data {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fef2f2;
  border: 1.5px solid #fecaca;
  color: var(--danger);
  padding: 7px 16px;
  border-radius: var(--radius-full);
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition);
}
.btn-clear-data:hover {
  background: #fee2e2;
  border-color: #f87171;
  color: #b91c1c;
  transform: translateY(-1px);
}
.btn-clear-data.prominent {
  background: linear-gradient(135deg, #fee2e2, #fef2f2);
  border: 1.5px solid #f87171;
  color: #b91c1c;
  padding: 8px 18px;
  font-size: 0.86rem;
  font-weight: 700;
  border-radius: var(--radius-full);
  box-shadow: 0 2px 6px rgba(220, 38, 38, 0.12);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.btn-clear-data.prominent:hover {
  background: #fecaca;
  border-color: #ef4444;
  color: #991b1b;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);
}
.settings-card.danger-card {
  border-left: 4px solid var(--danger);
  background: #fffafa;
  border: 1px solid #fecaca;
}
.btn-danger-solid {
  background: var(--danger);
  color: var(--white);
  border: none;
  padding: 9px 18px;
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  transition: var(--transition);
}
.btn-danger-solid:hover {
  background: #b91c1c;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
}
.modal-header-danger {
  border-bottom: 2px solid #ef4444;
}
.modal-header-danger h3 {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #dc2626;
}
.clear-alert-banner {
  background: #fff7ed;
  border: 1px solid #fdba74;
  border-left: 4px solid var(--orange-500);
  padding: 10px 14px;
  border-radius: var(--radius-md);
  font-size: 0.82rem;
  color: var(--orange-900);
  line-height: 1.5;
}
.clear-scope-options {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
}
.scope-radio-label {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-md);
  background: var(--white);
  cursor: pointer;
  font-size: 0.85rem;
  transition: var(--transition);
}
.scope-radio-label:hover {
  background: var(--orange-50);
  border-color: var(--orange-300);
}
.clear-preview-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: var(--radius-md);
  padding: 12px;
  margin-top: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.preview-badge {
  background: #fee2e2;
  color: #b91c1c;
  font-weight: 700;
  font-size: 0.85rem;
  padding: 4px 12px;
  border-radius: var(--radius-full);
}
.preview-text {
  font-size: 0.82rem;
  color: var(--gray-600);
}
.btn-danger-solid {
  background: var(--danger);
  color: var(--white);
  border: none;
  padding: 9px 20px;
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  transition: var(--transition);
}
.btn-danger-solid:hover:not(:disabled) {
  background: #b91c1c;
  box-shadow: 0 4px 12px rgba(220,38,38,0.3);
}
.btn-danger-solid:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ============================================================
   FOOTER
   ============================================================ */
.site-footer {
  background: linear-gradient(180deg, var(--navy-900) 0%, #060e1a 100%);
  color: rgba(255, 255, 255, 0.9);
  padding: 24px 16px 28px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-top: auto;
  text-align: center;
}
.footer-container {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 0 6px;
}
.footer-dept-name {
  font-size: clamp(0.9rem, 2.8vw, 1.05rem);
  font-weight: 700;
  color: var(--orange-400);
  letter-spacing: 0.02em;
  line-height: 1.35;
}
.footer-school-name {
  font-size: clamp(0.78rem, 3.2vw, 0.98rem);
  font-weight: 600;
  color: #f1f5f9;
  line-height: 1.4;
  letter-spacing: 0.01em;
  white-space: normal;
  word-break: keep-all;
  max-width: 100%;
}
.footer-dev-credit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 6px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(251, 146, 60, 0.3);
  padding: 6px 18px;
  border-radius: var(--radius-full);
  font-size: clamp(0.74rem, 2.5vw, 0.84rem);
  color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  white-space: nowrap;
}
.footer-dev-icon {
  font-size: 0.95rem;
}
.footer-dev-text {
  font-weight: 500;
  color: #fed7aa;
}

/* ============================================================
   RESPONSIVE — iPad, Tablets & Mobile Devices
   ============================================================ */
@media (max-width: 1024px) {
  .header-content {
    padding: 16px 20px 14px;
    gap: 16px;
  }
  .header-logo-wrap {
    width: 70px;
    height: 70px;
  }
  .school-name {
    font-size: 1.22rem;
  }
  .dept-name {
    font-size: 0.9rem;
  }
  .system-title {
    font-size: 0.85rem;
  }
  .main-nav {
    padding: 0 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .main-nav::-webkit-scrollbar {
    display: none;
  }
  .admin-stats {
    grid-template-columns: repeat(3, 1fr);
  }
  .report-summary-cards {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .site-header {
    overflow: visible;
  }
  .header-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 14px 10px;
  }
  .header-logo-wrap {
    width: 52px;
    height: 52px;
    padding: 3px;
    flex-shrink: 0;
  }
  .header-text {
    flex: 1 1 calc(100% - 66px);
    min-width: 0;
  }
  .school-name {
    font-size: 0.98rem;
    line-height: 1.3;
    word-break: keep-all;
  }
  .dept-name {
    font-size: 0.82rem;
    margin-top: 1px;
  }
  .system-title {
    font-size: 0.74rem;
    padding: 2px 10px;
    margin-top: 3px;
  }
  .header-actions {
    flex: 1 1 100%;
    display: flex;
    justify-content: stretch;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .btn-admin-login {
    width: 100%;
    justify-content: center;
    padding: 8px 14px;
    font-size: 0.82rem;
    border-radius: var(--radius-md);
  }
  .main-nav {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 0 8px;
    gap: 4px;
    background: rgba(0, 0, 0, 0.35);
  }
  .main-nav::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    flex-shrink: 0;
    padding: 9px 12px;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .nav-link.admin-only {
    color: #fed7aa;
    font-weight: 700;
    background: rgba(249, 115, 22, 0.18);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .nav-link.admin-only.active {
    background: rgba(249, 115, 22, 0.32);
    color: var(--white);
    border-bottom-color: var(--orange-400);
  }
  .btn-nav-refresh {
    flex-shrink: 0;
    margin-left: auto;
    padding: 5px 10px;
    font-size: 0.74rem;
  }
  .main-content {
    padding: 14px 10px;
  }
  .form-container {
    padding: 18px 14px;
  }
  .form-row.two-col {
    grid-template-columns: 1fr;
  }
  .datetime-row {
    grid-template-columns: 1fr;
  }
  .calendar-controls {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding: 12px;
  }
  .calendar-nav {
    justify-content: space-between;
    width: 100%;
  }
  .calendar-view-toggle {
    width: 100%;
    display: flex;
    gap: 4px;
  }
  .view-toggle-btn {
    flex: 1;
    text-align: center;
    padding: 7px 6px;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .calendar-filter {
    width: 100%;
    flex-wrap: wrap;
  }
  .calendar-filter .form-select {
    flex: 1;
    min-width: 160px;
  }
  .cal-mobile-hint {
    display: flex;
  }
  .calendar-grid {
    min-width: 660px;
  }
  .calendar-grid.cal-mode-fit {
    min-width: 0 !important;
  }
  .admin-manage-toolbar {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .admin-tabs {
    width: 100%;
    display: flex;
  }
  .admin-tab {
    flex: 1;
    text-align: center;
  }
  .btn-clear-data.prominent {
    width: 100%;
    justify-content: center;
    padding: 9px 14px;
  }
  .admin-stats {
    grid-template-columns: 1fr 1fr;
  }
  .report-summary-cards {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 480px) {
  .admin-stats {
    grid-template-columns: 1fr;
  }
  .report-summary-cards {
    grid-template-columns: 1fr;
  }
  .view-toggle-btn {
    font-size: 0.72rem;
    padding: 6px 4px;
  }
}

@media (max-height: 520px) and (orientation: landscape) {
  .header-content {
    padding: 6px 12px 5px;
    gap: 8px;
  }
  .header-logo-wrap {
    width: 40px;
    height: 40px;
  }
  .school-name {
    font-size: 0.88rem;
  }
  .dept-name, .system-title {
    display: inline-block;
    margin: 0 4px 0 0;
    font-size: 0.7rem;
    padding: 1px 6px;
  }
  .calendar-controls {
    padding: 8px 10px;
    gap: 6px;
    margin-bottom: 8px;
  }
  .cal-day {
    min-height: 44px;
    padding: 2px 2px;
  }
}

</style>
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="site-header">
    <div class="header-bg-pattern"></div>
    <div class="header-content">
      <div class="header-logo-wrap">
        <img src="logo รร ดี.png" alt="Logo โรงเรียนวิทยาศาสตร์จุฬาภรณราชวิทยาลัย ปทุมธานี" class="school-logo" id="schoolLogo" />
      </div>
      <div class="header-text">
        <h1 class="school-name">โรงเรียนวิทยาศาสตร์จุฬาภรณราชวิทยาลัย ปทุมธานี</h1>
        <p class="dept-name">ฝ่ายบริหารงานทั่วไป</p>
        <p class="system-title">ระบบจองใช้สถานที่</p>
      </div>
      <div class="header-actions">
        <button class="btn-admin-login" id="btnAdminLogin" onclick="showAdminLogin()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
          เข้าสู่ระบบ Admin
        </button>
      </div>
    </div>
    <nav class="main-nav" id="mainNav">
      <a href="#" class="nav-link active" onclick="showPage('booking')" id="navBooking">📝 จองสถานที่</a>
      <a href="#" class="nav-link" onclick="showPage('calendar')" id="navCalendar">📅 ปฏิทินการจอง</a>
      <a href="#" class="nav-link admin-only hidden" onclick="showPage('admin')" id="navAdmin">⚙️ จัดการ (Admin)</a>
      <a href="#" class="nav-link admin-only hidden" onclick="showPage('report')" id="navReport">📊 รายงาน</a>
      <button type="button" class="btn-nav-refresh" onclick="manualRefreshData()" title="คลิกเพื่อรีเฟรชดึงข้อมูลล่าสุดจาก Google Sheets">
        🔄 รีเฟรชข้อมูล
      </button>
    </nav>
  </header>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="main-content">

    <!-- ===== PAGE: BOOKING FORM ===== -->
    <section class="page active" id="pageBooking">
      <div class="page-header">
        <h2 class="page-title">
          <span class="page-title-icon">📝</span>
          แบบฟอร์มจองใช้สถานที่
          <span class="cloud-status-tag syncing" onclick="manualRefreshData()" style="cursor:pointer;" title="คลิกเพื่อรีเฟรชข้อมูล">⏳ กำลังเชื่อมต่อ Google Sheets...</span>
        </h2>
        <p class="page-subtitle">กรุณากรอกข้อมูลให้ครบถ้วน ระบบจะตรวจสอบการจองซ้ำโดยอัตโนมัติ</p>
      </div>

      <div class="form-container">
        <form id="bookingForm" onsubmit="submitBooking(event)" novalidate>

          <!-- Row 1: Name + Position -->
          <div class="form-row two-col">
            <div class="form-group">
              <label for="fullName" class="form-label required">ชื่อ-นามสกุล</label>
              <input type="text" id="fullName" name="fullName" class="form-input" placeholder="กรอกชื่อ-นามสกุล" required />
              <span class="field-error" id="errFullName"></span>
            </div>
            <div class="form-group">
              <label for="position" class="form-label required">ตำแหน่ง</label>
              <select id="position" name="position" class="form-select" onchange="toggleOtherPosition()" required>
                <option value="">-- เลือกตำแหน่ง --</option>
                <option value="ครู">ครู</option>
                <option value="ครูผู้ช่วย">ครูผู้ช่วย</option>
                <option value="พนักงานราชการ">พนักงานราชการ</option>
                <option value="เจ้าหน้าที่">เจ้าหน้าที่</option>
                <option value="อื่น ๆ">อื่น ๆ (ระบุ)</option>
              </select>
              <input type="text" id="positionOther" class="form-input mt-8 hidden" placeholder="ระบุตำแหน่ง... *" />
              <span class="field-error" id="errPosition"></span>
            </div>
          </div>

          <!-- Row 2: Department + Room -->
          <div class="form-row two-col">
            <div class="form-group">
              <label for="department" class="form-label required">ฝ่ายงาน</label>
              <select id="department" name="department" class="form-select" required>
                <option value="">-- เลือกฝ่ายงาน --</option>
                <option value="ฝ่ายบริหารงานวิชาการ">ฝ่ายบริหารงานวิชาการ</option>
                <option value="ฝ่ายบริหารงานงบประมาณ">ฝ่ายบริหารงานงบประมาณ</option>
                <option value="ฝ่ายบริหารงานกิจการนักเรียนและหอพัก">ฝ่ายบริหารงานกิจการนักเรียนและหอพัก</option>
                <option value="ฝ่ายบริหารงานทั่วไป">ฝ่ายบริหารงานทั่วไป</option>
                <option value="งานบุคคล">งานบุคคล</option>
              </select>
              <span class="field-error" id="errDepartment"></span>
            </div>
            <div class="form-group">
              <label for="room" class="form-label required">ห้องที่จอง</label>
              <select id="room" name="room" class="form-select" onchange="handleRoomChange()" required>
                <option value="">-- เลือกห้อง/สถานที่ --</option>
                <optgroup label="🏢 ห้องประชุม / หอประชุม (เลือกได้ 1 ห้อง)">
                  <option value="บรรยายรวม">บรรยายรวม</option>
                  <option value="หอประชุม 1">หอประชุม 1</option>
                  <option value="หอประชุม 2">หอประชุม 2</option>
                  <option value="ห้องประชุมพระยาสุรินทร์">ห้องประชุมพระยาสุรินทร์</option>
                  <option value="ห้องประชุมแคแสด">ห้องประชุมแคแสด</option>
                  <option value="ห้องประชุมสุวรรณภูมิ">ห้องประชุมสุวรรณภูมิ</option>
                </optgroup>
                <optgroup label="🏟️ สถานที่อื่น ๆ (เลือกได้ 1 ห้อง)">
                  <option value="โรงอาหาร">โรงอาหาร</option>
                  <option value="โรงยิมชั้น 1">โรงยิมชั้น 1</option>
                  <option value="โรงยิมชั้น 2">โรงยิมชั้น 2</option>
                  <option value="โดมอเนกประสงค์">โดมอเนกประสงค์</option>
                </optgroup>
                <optgroup label="🏫 ห้องเรียน ม.1 ถึง ม.6 (สามารถเลือกหลายห้องได้)">
                  <option value="__m1">ห้องเรียน ม.1 (ห้อง 101–104)</option>
                  <option value="__m2">ห้องเรียน ม.2 (ห้อง 201–204)</option>
                  <option value="__m3">ห้องเรียน ม.3 (ห้อง 301–304)</option>
                  <option value="__m4">ห้องเรียน ม.4 (ห้อง 401–406)</option>
                  <option value="__m5">ห้องเรียน ม.5 (ห้อง 501–506)</option>
                  <option value="__m6">ห้องเรียน ม.6 (ห้อง 601–606)</option>
                </optgroup>
              </select>

              <!-- Classroom Multi-select Panel (shown for classroom selections) -->
              <div id="classroomSelector" class="classroom-selector hidden">
                <div class="cr-header">
                  <div class="cr-title">
                    <span class="cr-icon">🏫</span>
                    <span>เลือกห้องเรียน (คลิกเลือกได้หลายห้องพร้อมกัน):</span>
                  </div>
                  <div class="cr-quick-actions">
                    <button type="button" class="btn-cr-action" onclick="selectAllCurrentGrade()">✓ เลือกทุกห้องในระดับนี้</button>
                    <button type="button" class="btn-cr-action clear" onclick="clearClassroomSelection()">✕ ล้างที่เลือก</button>
                  </div>
                </div>

                <!-- Grade Tabs (ม.1 – ม.6) -->
                <div class="cr-grade-tabs" id="crGradeTabs">
                  <button type="button" class="cr-tab active" data-grade="__m1" onclick="switchClassroomGrade('__m1')">ม.1</button>
                  <button type="button" class="cr-tab" data-grade="__m2" onclick="switchClassroomGrade('__m2')">ม.2</button>
                  <button type="button" class="cr-tab" data-grade="__m3" onclick="switchClassroomGrade('__m3')">ม.3</button>
                  <button type="button" class="cr-tab" data-grade="__m4" onclick="switchClassroomGrade('__m4')">ม.4</button>
                  <button type="button" class="cr-tab" data-grade="__m5" onclick="switchClassroomGrade('__m5')">ม.5</button>
                  <button type="button" class="cr-tab" data-grade="__m6" onclick="switchClassroomGrade('__m6')">ม.6</button>
                </div>

                <!-- Room Checkbox Cards Grid -->
                <div class="cr-rooms-grid" id="crRoomsGrid"></div>

                <!-- Selected Summary Chips Bar -->
                <div class="cr-selected-bar">
                  <span class="cr-selected-label">ห้องที่เลือก:</span>
                  <div class="cr-selected-chips" id="crSelectedChips">
                    <span class="cr-no-selection">ยังไม่ได้เลือกห้อง (คลิกเลือกห้องด้านบน)</span>
                  </div>
                </div>
              </div>

              <span class="field-error" id="errRoom"></span>
            </div>
          </div>

          <!-- Row 3: Purpose -->
          <div class="form-row">
            <div class="form-group">
              <label for="purpose" class="form-label required">วัตถุประสงค์การใช้สถานที่</label>
              <textarea id="purpose" name="purpose" class="form-textarea" placeholder="กรอกวัตถุประสงค์การใช้สถานที่..." rows="3" required></textarea>
              <span class="field-error" id="errPurpose"></span>
            </div>
          </div>

          <!-- Row 4: Users count + Grade -->
          <div class="form-row two-col">
            <div class="form-group">
              <label for="studentCount" class="form-label required">จำนวนผู้ใช้ห้อง (คน)</label>
              <input type="number" id="studentCount" name="studentCount" class="form-input" placeholder="เช่น 40, 150" min="1" required />
              <span class="field-error" id="errStudentCount"></span>
            </div>
            <div class="form-group">
              <label for="grade" class="form-label required">ระดับชั้น / กลุ่มผู้ใช้</label>
              <input type="text" id="grade" name="grade" class="form-input" placeholder="เช่น ม.4/1, ม.5 ทุกห้อง, คณะครู" required />
              <span class="field-error" id="errGrade"></span>
            </div>
          </div>

          <!-- Row 5: Date & Time -->
          <div class="form-row">
            <div class="form-group">
              <label class="form-label required">วันที่และเวลาที่ใช้สถานที่</label>
              <div class="datetime-row">
                <div class="datetime-field">
                  <label for="bookingDate" class="sub-label required">วันที่</label>
                  <input type="date" id="bookingDate" name="bookingDate" class="form-input" required />
                </div>
                <div class="datetime-field">
                  <label for="startTime" class="sub-label required">เวลาเริ่มต้น</label>
                  <input type="time" id="startTime" name="startTime" class="form-input" required />
                </div>
                <div class="datetime-field">
                  <label for="endTime" class="sub-label required">เวลาสิ้นสุด</label>
                  <input type="time" id="endTime" name="endTime" class="form-input" required />
                </div>
              </div>
              <span class="field-error" id="errDateTime"></span>
            </div>
          </div>

          <!-- Row 6: Room Layout -->
          <div class="form-row">
            <div class="form-group">
              <label for="roomLayout" class="form-label required">รูปแบบการจัดห้อง</label>
              <input type="text" id="roomLayout" name="roomLayout" class="form-input" placeholder="เช่น โรงภาพยนตร์, ประชุมกลุ่ม, รูปตัว U, จัดตามสภาพห้องเดิม" required />
              <span class="field-error" id="errRoomLayout"></span>
            </div>
          </div>

          <!-- Submit -->
          <div class="form-actions">
            <button type="button" class="btn-secondary" onclick="clearForm()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
              ล้างข้อมูล
            </button>
            <button type="submit" class="btn-primary" id="btnSubmit">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              ยืนยันการจอง
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- ===== PAGE: CALENDAR ===== -->
    <section class="page hidden" id="pageCalendar">
      <div class="page-header">
        <h2 class="page-title">
          <span class="page-title-icon">📅</span>
          ปฏิทินการจองสถานที่
          <span class="cloud-status-tag syncing" onclick="manualRefreshData()" style="cursor:pointer;" title="คลิกเพื่อรีเฟรชข้อมูล">⏳ กำลังเชื่อมต่อ Google Sheets...</span>
        </h2>
        <p class="page-subtitle">แสดงภาพรวมการจองสถานที่ในแต่ละเดือน คลิกวันเพื่อดูรายละเอียด</p>
      </div>

      <div class="calendar-controls">
        <div class="calendar-nav">
          <button class="btn-cal-nav" onclick="prevMonth()">&#8249;</button>
          <span class="cal-month-display" id="calMonthDisplay"></span>
          <button class="btn-cal-nav" onclick="nextMonth()">&#8250;</button>
        </div>
        <div class="calendar-view-toggle" id="calViewToggle">
          <button type="button" class="view-toggle-btn active" id="btnViewFit" onclick="setCalViewMode('fit')" title="ตารางเดือนขนาดพอดีหน้าจอ 100% ดูได้ครบทั้งสัปดาห์">
            📱 พอดีหน้าจอ
          </button>
          <button type="button" class="view-toggle-btn" id="btnViewScroll" onclick="setCalViewMode('scroll')" title="ตารางเดือนแบบขยายเต็ม เลื่อนซ้าย-ขวาได้">
            ↔️ ขยายเต็ม (เลื่อนดู)
          </button>
          <button type="button" class="view-toggle-btn" id="btnViewList" onclick="setCalViewMode('list')" title="แสดงเป็นรายการจองทั้งหมดของเดือน">
            📋 รายการจอง
          </button>
        </div>
        <div class="calendar-filter">
          <label for="filterRoom" class="filter-label">กรองตามห้อง:</label>
          <select id="filterRoom" class="form-select" onchange="renderCalendar()">
            <option value="">ทุกห้อง / ทุกสถานที่</option>
            <optgroup label="🏢 ห้องประชุม / หอประชุม">
              <option value="บรรยายรวม">บรรยายรวม</option>
              <option value="หอประชุม 1">หอประชุม 1</option>
              <option value="หอประชุม 2">หอประชุม 2</option>
              <option value="ห้องประชุมพระยาสุรินทร์">ห้องประชุมพระยาสุรินทร์</option>
              <option value="ห้องประชุมแคแสด">ห้องประชุมแคแสด</option>
              <option value="ห้องประชุมสุวรรณภูมิ">ห้องประชุมสุวรรณภูมิ</option>
            </optgroup>
            <optgroup label="🏟️ สถานที่อื่น ๆ">
              <option value="โรงอาหาร">โรงอาหาร</option>
              <option value="โรงยิมชั้น 1">โรงยิมชั้น 1</option>
              <option value="โรงยิมชั้น 2">โรงยิมชั้น 2</option>
              <option value="โดมอเนกประสงค์">โดมอเนกประสงค์</option>
            </optgroup>
            <optgroup label="🏫 ห้องเรียน ม.1">
              <option value="ห้อง 101">ห้อง 101</option>
              <option value="ห้อง 102">ห้อง 102</option>
              <option value="ห้อง 103">ห้อง 103</option>
              <option value="ห้อง 104">ห้อง 104</option>
            </optgroup>
            <optgroup label="🏫 ห้องเรียน ม.2">
              <option value="ห้อง 201">ห้อง 201</option>
              <option value="ห้อง 202">ห้อง 202</option>
              <option value="ห้อง 203">ห้อง 203</option>
              <option value="ห้อง 204">ห้อง 204</option>
            </optgroup>
            <optgroup label="🏫 ห้องเรียน ม.3">
              <option value="ห้อง 301">ห้อง 301</option>
              <option value="ห้อง 302">ห้อง 302</option>
              <option value="ห้อง 303">ห้อง 303</option>
              <option value="ห้อง 304">ห้อง 304</option>
            </optgroup>
            <optgroup label="🏫 ห้องเรียน ม.4">
              <option value="ห้อง 401">ห้อง 401</option>
              <option value="ห้อง 402">ห้อง 402</option>
              <option value="ห้อง 403">ห้อง 403</option>
              <option value="ห้อง 404">ห้อง 404</option>
              <option value="ห้อง 405">ห้อง 405</option>
              <option value="ห้อง 406">ห้อง 406</option>
            </optgroup>
            <optgroup label="🏫 ห้องเรียน ม.5">
              <option value="ห้อง 501">ห้อง 501</option>
              <option value="ห้อง 502">ห้อง 502</option>
              <option value="ห้อง 503">ห้อง 503</option>
              <option value="ห้อง 504">ห้อง 504</option>
              <option value="ห้อง 505">ห้อง 505</option>
              <option value="ห้อง 506">ห้อง 506</option>
            </optgroup>
            <optgroup label="🏫 ห้องเรียน ม.6">
              <option value="ห้อง 601">ห้อง 601</option>
              <option value="ห้อง 602">ห้อง 602</option>
              <option value="ห้อง 603">ห้อง 603</option>
              <option value="ห้อง 604">ห้อง 604</option>
              <option value="ห้อง 605">ห้อง 605</option>
              <option value="ห้อง 606">ห้อง 606</option>
            </optgroup>
          </select>
          <button type="button" class="btn-secondary" onclick="manualRefreshData()" title="ดึงข้อมูลล่าสุดจาก Google Sheets" style="padding:8px 14px;font-size:0.85rem;white-space:nowrap;">
            🔄 รีเฟรชข้อมูล
          </button>
        </div>
      </div>

      <div class="calendar-legend">
        <span class="legend-item"><span class="legend-dot booked"></span> มีการจอง</span>
        <span class="legend-item"><span class="legend-dot cancelled"></span> ยกเลิก</span>
        <span class="legend-item"><span class="legend-dot today"></span> วันนี้</span>
      </div>

      <div class="cal-mobile-hint" id="calMobileHint">
        <span>👈 เลื่อนซ้าย-ขวา เพื่อดูตารางทั้งสัปดาห์ (แตะวันที่เพื่อดูรายละเอียด) 👉</span>
      </div>

      <div class="calendar-scroll-wrap" id="calendarScrollWrap">
        <div class="calendar-grid" id="calendarGrid"></div>
      </div>

      <div class="calendar-list-view hidden" id="calendarListView"></div>

      <!-- Day Detail Modal -->
      <div class="day-detail-modal hidden" id="dayDetailModal">
        <div class="day-detail-content">
          <div class="day-detail-header">
            <h3 id="dayDetailTitle"></h3>
            <button class="btn-close-modal" onclick="closeDayDetail()">✕</button>
          </div>
          <div id="dayDetailBody"></div>
        </div>
      </div>
    </section>

    <!-- ===== PAGE: ADMIN ===== -->
    <section class="page hidden" id="pageAdmin">
      <div class="page-header">
        <h2 class="page-title">
          <span class="page-title-icon">⚙️</span>
          จัดการการจอง (Admin)
        </h2>
      </div>

      <div class="admin-stats" id="adminStats"></div>

      <div class="admin-section-tabs">
        <button class="section-tab active" onclick="switchSection('manage')" id="sectManage">📋 รายการจอง</button>
        <button class="section-tab" onclick="switchSection('report')" id="sectReport">📊 รายงานสรุป</button>
        <button class="section-tab" onclick="switchSection('settings')" id="sectSettings">🔐 ตั้งค่า Admin</button>
      </div>

      <!-- Section: Manage bookings -->
      <div id="sectionManage">
        <div class="admin-manage-toolbar">
          <div class="admin-tabs">
            <button class="admin-tab active" onclick="switchAdminTab('approved')" id="tabApproved">จองแล้ว <span class="tab-badge" id="approvedBadge">0</span></button>
            <button class="admin-tab" onclick="switchAdminTab('cancelled')" id="tabCancelled">ยกเลิก</button>
          </div>
          <button type="button" class="btn-clear-data prominent" onclick="openClearDataModal()" title="ล้างข้อมูลการจอง (รายวัน, รายสัปดาห์, รายเดือน, ทั้งหมด)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
            <span>🗑️ ล้างข้อมูลการจอง (รายวัน / สัปดาห์ / เดือน / ทั้งหมด)</span>
          </button>
        </div>
        <div class="history-table-wrap" id="adminTableWrap">
          <table class="history-table">
            <thead>
              <tr>
                <th>#</th>
                <th>ชื่อ-นามสกุล</th>
                <th>ตำแหน่ง</th>
                <th>ฝ่าย</th>
                <th>ห้อง</th>
                <th>วันที่ใช้</th>
                <th>เวลา</th>
                <th>วัตถุประสงค์</th>
                <th>วันที่จอง</th>
                <th>การดำเนินการ</th>
              </tr>
            </thead>
            <tbody id="adminBody"></tbody>
          </table>
          <div class="empty-state hidden" id="adminEmpty">
            <div class="empty-icon">📭</div>
            <p>ไม่มีรายการในหมวดนี้</p>
          </div>
        </div>
      </div>

      <!-- Section: Report -->
      <div id="sectionReport" class="hidden">
        <div class="report-controls">
          <div class="report-select-wrap">
            <label class="form-label">ช่วงเวลา</label>
            <select id="reportPeriodType" class="form-select" onchange="renderAdminReport()">
              <option value="daily">รายวัน</option>
              <option value="weekly">รายสัปดาห์</option>
              <option value="monthly" selected>รายเดือน</option>
              <option value="yearly">รายปี</option>
            </select>
          </div>
          <div class="report-select-wrap" id="reportDateWrap">
            <label class="form-label">วันที่</label>
            <input type="date" id="reportDate" class="form-input" onchange="renderAdminReport()" />
          </div>
          <div class="report-select-wrap hidden" id="reportWeekWrap">
            <label class="form-label">สัปดาห์</label>
            <input type="week" id="reportWeek" class="form-input" onchange="renderAdminReport()" />
          </div>
          <div class="report-select-wrap hidden" id="reportMonthWrap">
            <label class="form-label">เดือน</label>
            <select id="reportMonth" class="form-select" onchange="renderAdminReport()"></select>
          </div>
          <div class="report-select-wrap hidden" id="reportYearSelectWrap">
            <label class="form-label">ปี (พ.ศ.)</label>
            <select id="reportYear" class="form-select" onchange="renderAdminReport()"></select>
          </div>
          <button class="btn-primary" onclick="exportReportPDF()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Export PDF
          </button>
        </div>

        <div class="report-summary-cards" id="reportSummaryCards"></div>

        <div class="report-section">
          <h3 class="report-section-title">สรุปการจองแยกตามสถานที่</h3>
          <div class="report-table-wrap">
            <table class="history-table">
              <thead><tr><th>ห้อง/สถานที่</th><th>จำนวนการจอง</th><th>จำนวนชั่วโมงรวม</th><th>ยกเลิก</th></tr></thead>
              <tbody id="reportRoomBody"></tbody>
            </table>
          </div>
        </div>

        <div class="report-section">
          <h3 class="report-section-title">รายละเอียดการจองทั้งหมด</h3>
          <div class="report-table-wrap">
            <table class="history-table">
              <thead><tr><th>#</th><th>ชื่อ-นามสกุล</th><th>ฝ่าย</th><th>ห้อง</th><th>วันที่ใช้</th><th>เวลา</th><th>สถานะ</th></tr></thead>
              <tbody id="reportDetailBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Section: Settings (Change Password) -->
      <div id="sectionSettings" class="hidden">
        <div class="settings-card">
          <h3 class="settings-title">🔐 เปลี่ยนรหัสผ่าน Admin</h3>
          <div class="form-group">
            <label class="form-label">รหัสผ่านปัจจุบัน</label>
            <input type="password" id="pwdCurrent" class="form-input" placeholder="รหัสผ่านปัจจุบัน" />
          </div>
          <div class="form-group">
            <label class="form-label">รหัสผ่านใหม่</label>
            <input type="password" id="pwdNew" class="form-input" placeholder="รหัสผ่านใหม่ (อย่างน้อย 6 ตัวอักษร)" />
          </div>
          <div class="form-group">
            <label class="form-label">ยืนยันรหัสผ่านใหม่</label>
            <input type="password" id="pwdConfirm" class="form-input" placeholder="พิมพ์รหัสผ่านใหม่อีกครั้ง" />
          </div>
          <span class="field-error" id="errPwd"></span>
          <div style="margin-top:16px">
            <button class="btn-primary" onclick="changePassword()">💾 บันทึกรหัสผ่านใหม่</button>
          </div>
        </div>

        <!-- Section: Data Management (Clear Bookings) -->
        <div class="settings-card danger-card" style="margin-top:20px;">
          <h3 class="settings-title" style="color:var(--danger);display:flex;align-items:center;gap:8px;">
            🗑️ จัดการล้างข้อมูลประวัติการจอง
          </h3>
          <p style="font-size:0.875rem;color:var(--gray-600);margin-bottom:14px;line-height:1.5;">
            สามารถเลือกล้างข้อมูลการจองรายเดือน รายสัปดาห์ รายวัน หรือล้างข้อมูลทั้งหมดออกจากระบบและ Google Sheets ได้ตามต้องการ
          </p>
          <button type="button" class="btn-danger-solid" onclick="openClearDataModal()" style="display:inline-flex;align-items:center;gap:8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
            ล้างข้อมูลประวัติการจอง...
          </button>
        </div>
      </div>
    </section>

  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-dept-name">ฝ่ายบริหารงานทั่วไป</div>
      <div class="footer-school-name">โรงเรียนวิทยาศาสตร์จุฬาภรณราชวิทยาลัยปทุมธานี</div>
      <div class="footer-dev-credit">
        <span class="footer-dev-icon">💻</span>
        <span class="footer-dev-text">พัฒนาระบบโดยครูชลธีร์ จันทร์ลอย</span>
      </div>
    </div>
  </footer>

  <!-- ===== MODALS ===== -->

  <!-- Admin Login Modal -->
  <div class="modal-overlay hidden" id="adminLoginModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3>🔐 เข้าสู่ระบบ Admin</h3>
        <button class="btn-close-modal" onclick="closeAdminLogin()">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="adminUser" class="form-label">ชื่อผู้ใช้</label>
          <input type="text" id="adminUser" class="form-input" placeholder="Username" />
        </div>
        <div class="form-group">
          <label for="adminPass" class="form-label">รหัสผ่าน</label>
          <input type="password" id="adminPass" class="form-input" placeholder="Password" onkeydown="if(event.key==='Enter')doAdminLogin()" />
        </div>
        <span class="field-error" id="errLogin"></span>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeAdminLogin()">ยกเลิก</button>
        <button class="btn-primary" onclick="doAdminLogin()">เข้าสู่ระบบ</button>
      </div>
    </div>
  </div>

  <!-- Clear Data Modal -->
  <div class="modal-overlay hidden" id="clearDataModal">
    <div class="modal-box clear-data-box">
      <div class="modal-header modal-header-danger">
        <h3>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          ล้างข้อมูลประวัติการจอง
        </h3>
        <button class="btn-close-modal" onclick="closeClearDataModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="clear-alert-banner">
          ⚠️ <strong>ข้อควรระวัง:</strong> การล้างข้อมูลจะลบรายการออกจากระบบ และซิงค์ลบแถวออกจาก Google Sheets ด้วย ข้อมูลที่ลบแล้วจะไม่สามารถกู้คืนได้
        </div>

        <div class="form-group" style="margin-top:14px;">
          <label class="form-label required">เลือกรูปแบบการล้างข้อมูล:</label>
          <div class="clear-scope-options">
            <label class="scope-radio-label">
              <input type="radio" name="clearScope" value="all" checked onchange="onClearScopeChange()" />
              <span><strong>ล้างข้อมูลทั้งหมด</strong> (ทุกช่วงเวลา ทุกรายการ)</span>
            </label>
            <label class="scope-radio-label">
              <input type="radio" name="clearScope" value="monthly" onchange="onClearScopeChange()" />
              <span><strong>ล้างข้อมูลรายเดือน</strong> (ระบุเดือนและปี)</span>
            </label>
            <label class="scope-radio-label">
              <input type="radio" name="clearScope" value="weekly" onchange="onClearScopeChange()" />
              <span><strong>ล้างข้อมูลรายสัปดาห์</strong> (ระบุสัปดาห์)</span>
            </label>
            <label class="scope-radio-label">
              <input type="radio" name="clearScope" value="daily" onchange="onClearScopeChange()" />
              <span><strong>ล้างข้อมูลรายวัน</strong> (ระบุวันที่)</span>
            </label>
          </div>
        </div>

        <!-- Dynamic Parameter Wrappers -->
        <div id="clearParamMonthWrap" class="form-row two-col hidden" style="margin-top:10px;">
          <div class="form-group">
            <label class="form-label">เลือกเดือน</label>
            <select id="clearMonthSelect" class="form-select" onchange="updateClearPreview()"></select>
          </div>
          <div class="form-group">
            <label class="form-label">เลือกปี (พ.ศ.)</label>
            <select id="clearYearSelect" class="form-select" onchange="updateClearPreview()"></select>
          </div>
        </div>

        <div id="clearParamWeekWrap" class="form-group hidden" style="margin-top:10px;">
          <label class="form-label">เลือกสัปดาห์</label>
          <input type="week" id="clearWeekInput" class="form-input" onchange="updateClearPreview()" />
        </div>

        <div id="clearParamDateWrap" class="form-group hidden" style="margin-top:10px;">
          <label class="form-label">เลือกวันที่</label>
          <input type="date" id="clearDateInput" class="form-input" onchange="updateClearPreview()" />
        </div>

        <!-- Filter status option -->
        <div class="form-group" style="margin-top:14px;">
          <label class="form-label">สถานะของรายการที่ต้องการล้าง:</label>
          <select id="clearStatusFilter" class="form-select" onchange="updateClearPreview()">
            <option value="all">ล้างทุกสถานะ (ทั้งจองแล้วและยกเลิก)</option>
            <option value="cancelled">ล้างเฉพาะรายการที่ "ยกเลิกแล้ว" เท่านั้น</option>
            <option value="approved">ล้างเฉพาะรายการที่ "จองแล้ว" เท่านั้น</option>
          </select>
        </div>

        <!-- Live Preview Box -->
        <div class="clear-preview-box" id="clearPreviewBox">
          <span class="preview-badge" id="clearPreviewCount">กำลังคำนวณ...</span>
          <span class="preview-text" id="clearPreviewText">รายการที่จะถูกลบ</span>
        </div>

        <!-- Safety Confirmation Checkbox -->
        <div class="clear-confirm-check" style="margin-top:16px;">
          <label style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;cursor:pointer;">
            <input type="checkbox" id="chkConfirmClear" onchange="toggleClearSubmitBtn()" style="margin-top:4px;" />
            <span>ฉันเข้าใจและยืนยันที่จะลบข้อมูลข้างต้นออกจากระบบและ Google Sheets</span>
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" onclick="closeClearDataModal()">ยกเลิก</button>
        <button type="button" class="btn-danger-solid" id="btnExecuteClear" onclick="executeClearBookings()" disabled>
          🗑️ ยืนยันการล้างข้อมูล
        </button>
      </div>
    </div>
  </div>

  <!-- Success Modal -->
  <div class="modal-overlay hidden" id="successModal">
    <div class="modal-box success-modal">
      <div class="success-icon">✅</div>
      <h3>จองสำเร็จ!</h3>
      <p id="successMessage"></p>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeSuccess()">ปิด</button>
        <button class="btn-primary" onclick="printCurrentBooking()">🖨️ พิมพ์ใบจอง</button>
      </div>
    </div>
  </div>

  <!-- Booking Detail Modal -->
  <div class="modal-overlay hidden" id="bookingDetailModal">
    <div class="modal-box large-modal">
      <div class="modal-header">
        <h3>📋 รายละเอียดการจอง</h3>
        <button class="btn-close-modal" onclick="closeBookingDetail()">✕</button>
      </div>
      <div class="modal-body" id="bookingDetailBody"></div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeBookingDetail()">ปิด</button>
        <button class="btn-primary" onclick="printCurrentDetail()">🖨️ พิมพ์ใบจอง</button>
      </div>
    </div>
  </div>

  <!-- Edit Booking Modal -->
  <div class="modal-overlay hidden" id="editModal">
    <div class="modal-box large-modal">
      <div class="modal-header">
        <h3>✏️ แก้ไขการจอง</h3>
        <button class="btn-close-modal" onclick="closeEdit()">✕</button>
      </div>
      <div class="modal-body" id="editBody"></div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeEdit()">ยกเลิก</button>
        <button class="btn-primary" onclick="saveEdit()">💾 บันทึก</button>
      </div>
    </div>
  </div>

  <!-- Conflict Warning Modal -->
  <div class="modal-overlay hidden" id="conflictModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3>⚠️ มีการจองซ้ำกัน!</h3>
        <button class="btn-close-modal" onclick="closeConflict()">✕</button>
      </div>
      <div class="modal-body">
        <div id="conflictDetail" class="conflict-detail"></div>
      </div>
      <div class="modal-footer">
        <button class="btn-primary" onclick="closeConflict()">รับทราบ</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast hidden" id="toast"><span id="toastMsg"></span></div>

  <!-- Google Sheets Integration Config -->
  <script src="google-sheets-config.js?v=20261005_4"></script>
  <script src="app.js?v=20261005_4"></script>
</body>
</html>
